{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Towow Public Archival Case",
  "type": "object",
  "required": [
    "case_id",
    "title",
    "domain",
    "period",
    "outcome",
    "research_role",
    "coding_status",
    "source_ids",
    "evidence_coverage",
    "initial_relation_frame",
    "authority_topology",
    "timeline",
    "supports",
    "does_not_support",
    "competing_explanations",
    "design_delta",
    "unknowns"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "research_role": {
      "type": "string"
    },
    "coding_status": {
      "enum": [
        "single_coder_provisional",
        "double_coded",
        "adjudicated"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_coverage": {
      "type": "object",
      "required": [
        "source_proximity",
        "process_granularity",
        "authority_visibility",
        "effect_observability",
        "participant_voice_coverage",
        "counterfactual_support",
        "triangulation",
        "selection_bias_risk"
      ]
    },
    "initial_relation_frame": {
      "type": "object",
      "required": [
        "frame_scope",
        "R",
        "V",
        "T",
        "A",
        "E",
        "D",
        "O"
      ]
    },
    "authority_topology": {
      "type": "array",
      "minItems": 2
    },
    "timeline": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "date",
          "label",
          "event_type",
          "materiality",
          "changed_components",
          "formation_operators",
          "description",
          "source_ids",
          "confidence",
          "epistemic_status"
        ]
      }
    },
    "supports": {
      "type": "array"
    },
    "does_not_support": {
      "type": "array"
    },
    "competing_explanations": {
      "type": "array"
    },
    "design_delta": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    }
  }
}
