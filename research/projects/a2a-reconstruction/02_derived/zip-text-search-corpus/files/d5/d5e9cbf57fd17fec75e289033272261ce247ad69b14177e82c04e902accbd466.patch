diff --git a/harness/tests/integration/test_consensus_reference_migration_cli.py b/harness/tests/integration/test_consensus_reference_migration_cli.py
new file mode 100644
index 000000000..e011b4a6b
--- /dev/null
+++ b/harness/tests/integration/test_consensus_reference_migration_cli.py
@@ -0,0 +1,247 @@
+"""Reference migration CLI closes the concept-retire gate's required evidence path."""
+
+from __future__ import annotations
+
+import json
+from typing import TYPE_CHECKING, Any
+
+import pytest
+from click.testing import CliRunner
+
+from tests.integration.test_run092_at_reference_lock_cli import (
+    _consensus_project,
+    _create_concept,
+)
+from towow.cli.main import cli
+from towow.l0.event_log.event_log import EventLog
+from towow.l0.event_log.segments import iter_raw_event_lines
+from towow.l0.projection.projection import ProjectionStore
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+
+@pytest.fixture
+def runner() -> CliRunner:
+    return CliRunner()
+
+
+def _events(tmp_path: Path, event_type: str) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    for line in iter_raw_event_lines(tmp_path / ".towow"):
+        rec = json.loads(line)
+        if isinstance(rec, dict) and rec.get("event_type") == event_type:
+            out.append(rec)
+    return out
+
+
+def _create_reference(
+    runner: CliRunner,
+    project: str,
+    source_id: str,
+    target_reference: str,
+) -> None:
+    result = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "concept-create",
+            "--project-dir",
+            project,
+            "--concept-id",
+            source_id,
+            "--name",
+            source_id,
+            "--definition",
+            "reference source fixture",
+            "--at-reference",
+            target_reference,
+        ],
+    )
+    assert result.exit_code == 0, result.output
+
+
+def test_ref_repoint_emits_add_then_remove_and_unblocks_supersede(
+    tmp_path: Path,
+    runner: CliRunner,
+) -> None:
+    project = _consensus_project(tmp_path, runner)
+    _create_concept(runner, project, "contract-old@v1", "old")
+    _create_concept(runner, project, "contract-new@v2", "new")
+    _create_reference(
+        runner,
+        project,
+        "consumer@v1",
+        "@concept:contract-old@v1",
+    )
+
+    repoint = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "ref-repoint",
+            "--project-dir",
+            project,
+            "--source-concept-id",
+            "consumer@v1",
+            "--old-reference",
+            "@concept:contract-old@v1",
+            "--new-reference",
+            "@concept:contract-new@v2",
+            "--reason",
+            "new contract replaces old contract",
+            "--novelty-type",
+            "new_evidence",
+        ],
+    )
+    assert repoint.exit_code == 0, repoint.output
+    added = _events(tmp_path, "AtReferenceAdded")
+    removed = _events(tmp_path, "AtReferenceRemoved")
+    assert any(
+        event["payload"]["after_state"]["source_concept_id"] == "consumer@v1"
+        and event["payload"]["after_state"]["at_reference"] == "@concept:contract-new@v2"
+        for event in added
+    )
+    assert any(
+        event["payload"]["before_state"]["reference_id"] == "@concept:contract-old@v1"
+        for event in removed
+    )
+
+    supersede = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "supersede",
+            "--project-dir",
+            project,
+            "--concept-id",
+            "contract-old@v1",
+            "--novelty",
+            "new evidence invalidates the old contract",
+            "--novelty-type",
+            "new_evidence",
+            "--replacement-concept-id",
+            "contract-new@v2",
+        ],
+    )
+    assert supersede.exit_code == 0, supersede.output
+    assert "ConceptGraphProposal" in supersede.output
+    invalidations = _events(tmp_path, "AtReferenceTargetSuperseded")
+    assert not any(
+        event.get("payload", {}).get("after_state", {}).get("reference_id")
+        == "@concept:contract-old@v1"
+        for event in invalidations
+    ), "supersede must not emit a false blocking event for the canonically removed reference"
+
+
+def test_ref_remove_rejects_wrong_source_and_removes_owned_reference(
+    tmp_path: Path,
+    runner: CliRunner,
+) -> None:
+    project = _consensus_project(tmp_path, runner)
+    _create_concept(runner, project, "target@v1", "target")
+    _create_reference(runner, project, "consumer@v1", "@concept:target@v1")
+
+    wrong = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "ref-remove",
+            "--project-dir",
+            project,
+            "--source-concept-id",
+            "other@v1",
+            "--reference",
+            "@concept:target@v1",
+            "--reason",
+            "wrong owner probe",
+            "--novelty-type",
+            "corrected_error",
+        ],
+    )
+    assert wrong.exit_code != 0
+    assert "not found" in wrong.output
+
+    remove = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "ref-remove",
+            "--project-dir",
+            project,
+            "--source-concept-id",
+            "consumer@v1",
+            "--reference",
+            "@concept:target@v1",
+            "--reason",
+            "consumer no longer depends on target",
+            "--novelty-type",
+            "scope_change",
+        ],
+    )
+    assert remove.exit_code == 0, remove.output
+    assert "AtReferenceRemoved" in remove.output
+
+
+def test_shared_locator_remove_preserves_other_owner_and_retire_gate_blocks(
+    tmp_path: Path,
+    runner: CliRunner,
+) -> None:
+    """Real CLI path: A and B share a locator; removing A leaves B live and blocks retirement."""
+    project = _consensus_project(tmp_path, runner)
+    locator = "@concept:shared-target@v1"
+    _create_concept(runner, project, "shared-target@v1", "target")
+    _create_reference(runner, project, "consumer-a@v1", locator)
+    _create_reference(runner, project, "consumer-b@v1", locator)
+
+    remove_a = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "ref-remove",
+            "--project-dir",
+            project,
+            "--source-concept-id",
+            "consumer-a@v1",
+            "--reference",
+            locator,
+            "--reason",
+            "consumer A no longer depends on target",
+            "--novelty-type",
+            "scope_change",
+        ],
+    )
+    assert remove_a.exit_code == 0, remove_a.output
+
+    towow = tmp_path / ".towow"
+    event_log = EventLog(towow / "events.log")
+    store = ProjectionStore(towow / "graph")
+    store.catchup(event_log)
+    graph = store.read("at_reference_graph") or {}
+    matching = [
+        ref
+        for ref in graph.get("references", [])
+        if isinstance(ref, dict) and ref.get("reference_id") == locator
+    ]
+    assert {
+        (ref.get("source_concept_id"), ref.get("is_active")) for ref in matching
+    } == {("consumer-a@v1", False), ("consumer-b@v1", True)}
+
+    retire = runner.invoke(
+        cli,
+        [
+            "consensus",
+            "supersede",
+            "--project-dir",
+            project,
+            "--concept-id",
+            "shared-target@v1",
+            "--novelty",
+            "retire shared target",
+            "--novelty-type",
+            "scope_change",
+        ],
+    )
+    assert retire.exit_code != 0
+    assert "concept_retire_unmigrated_dependents" in retire.output
+    assert "consumer-b@v1" in retire.output
