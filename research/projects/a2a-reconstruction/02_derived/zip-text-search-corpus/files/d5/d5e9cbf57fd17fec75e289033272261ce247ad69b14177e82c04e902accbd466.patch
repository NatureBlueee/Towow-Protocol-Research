@@ -217,6 +217,45 @@ def test_at_reference_graph_materializes_and_deactivates(tmp_path: Path) -> None
     assert ref2["is_active"] is False, "AtReferenceRemoved marks is_active=false, not delete"
 
 
+def test_at_reference_graph_scopes_locator_identity_by_source(tmp_path: Path) -> None:
+    store = ProjectionStore(tmp_path / "graph")
+    locator = "@concept:shared-target@v1"
+    for sequence, source in enumerate(("consumer-a@v1", "consumer-b@v1"), start=1):
+        store._apply(
+            _record(
+                EventType.AT_REFERENCE_ADDED,
+                {"after_state": {
+                    "source_concept_id": source,
+                    "at_reference": locator,
+                    "target_concept_name": "shared-target",
+                }},
+                sequence,
+            ),
+        )
+
+    store._apply(
+        _record(
+            EventType.AT_REFERENCE_REMOVED,
+            {"before_state": {
+                "reference_id": locator,
+                "source_entity": {"type": "concept", "id": "consumer-a@v1"},
+            }},
+            3,
+        ),
+    )
+
+    graph = store.read("at_reference_graph")
+    assert graph is not None
+    states = {
+        (ref["source_concept_id"], ref["reference_id"]): ref["is_active"]
+        for ref in graph["references"]
+    }
+    assert states == {
+        ("consumer-a@v1", locator): False,
+        ("consumer-b@v1", locator): True,
+    }
+
+
 # ═══ T-L0-07 ownership reducer ════════════════════════════════════════════════
 
 
