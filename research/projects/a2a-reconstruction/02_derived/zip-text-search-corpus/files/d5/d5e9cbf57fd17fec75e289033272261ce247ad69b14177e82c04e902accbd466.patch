+@consensus.command("ref-repoint")
+@click.option("--project-dir", type=click.Path(file_okay=False, path_type=Path), default=".")
+@click.option("--source-concept-id", required=True)
+@click.option("--old-reference", required=True, help="待退役的 active typed @ reference.")
+@click.option("--new-reference", required=True, help="同一 source 要重指的 typed @ reference.")
+@click.option(
+    "--ref-policy",
+    type=click.Choice([p.value for p in LockingPolicy]),
+    default=LockingPolicy.EXPLICIT_DECISION_REQUIRED.value,
+    show_default=True,
+)
+@click.option("--reason", required=True, help="重指原因，写入旧引用移除的 supersede provenance.")
+@click.option(
+    "--novelty-type",
+    type=click.Choice([t.value for t in SupersedeNoveltyType]),
+    required=True,
+)
+@click.option("--session-id", "session_id", default=None)
+def consensus_ref_repoint(
+    project_dir: Path,
+    source_concept_id: str,
+    old_reference: str,
+    new_reference: str,
+    ref_policy: str,
+    reason: str,
+    novelty_type: str,
+    session_id: str | None,
+) -> None:
+    """Repoint one existing source concept from an old typed ref to a new target.
+
+    The operation is crash-recoverable rather than pretending two sequential commit-gate
+    envelopes are atomic: rerun skips an already committed add and then removes the old ref.
+    """
+    towow = _require_init(project_dir)
+    sid = resolve_session(towow, "consensus", session_id).session_id
+    if old_reference == new_reference:
+        raise click.ClickException("old and new references must differ")
+    old_ref = _active_consensus_reference(towow, source_concept_id, old_reference)
+    if old_ref is None:
+        raise click.ClickException(
+            f"active old reference {old_reference!r} owned by {source_concept_id!r} not found"
+        )
+    parsed_new = _validate_reference_for_repoint(towow, new_reference)
+    new_ref = _active_consensus_reference(towow, source_concept_id, new_reference)
+    if new_ref is None:
+        add_event_id = _emit_consensus_reference_add(
+            towow, sid, source_concept_id, new_reference, parsed_new, ref_policy,
+        )
+        click.echo(f"  +AtReferenceAdded: {new_reference} (event: {add_event_id})")
+    else:
+        click.echo(f"  ~AtReferenceAdded skipped (already active): {new_reference}")
+    remove_event_id = _emit_consensus_reference_remove(
+        towow, sid, source_concept_id, old_reference, old_ref, reason, novelty_type,
+    )
+    click.echo(
+        f"✓ reference repointed: {source_concept_id} {old_reference} → {new_reference} "
+        f"(remove event: {remove_event_id})"
+    )
+
+
+@consensus.command("ref-remove")
+@click.option("--project-dir", type=click.Path(file_okay=False, path_type=Path), default=".")
+@click.option("--source-concept-id", required=True)
+@click.option("--reference", "reference_id", required=True, help="待移除的 active typed @ reference.")
+@click.option("--reason", required=True, help="移除原因，写入 supersede provenance.")
+@click.option(
+    "--novelty-type",
+    type=click.Choice([t.value for t in SupersedeNoveltyType]),
+    required=True,
+)
+@click.option("--session-id", "session_id", default=None)
+def consensus_ref_remove(
+    project_dir: Path,
+    source_concept_id: str,
+    reference_id: str,
+    reason: str,
+    novelty_type: str,
+    session_id: str | None,
+) -> None:
+    """Remove one active typed reference through the canonical commit gate."""
+    towow = _require_init(project_dir)
+    sid = resolve_session(towow, "consensus", session_id).session_id
+    active_ref = _active_consensus_reference(towow, source_concept_id, reference_id)
+    if active_ref is None:
+        raise click.ClickException(
+            f"active reference {reference_id!r} owned by {source_concept_id!r} not found"
+        )
+    event_id = _emit_consensus_reference_remove(
+        towow, sid, source_concept_id, reference_id, active_ref, reason, novelty_type,
+    )
+    click.echo(f"✓ AtReferenceRemoved: {reference_id} (event: {event_id})")
+
