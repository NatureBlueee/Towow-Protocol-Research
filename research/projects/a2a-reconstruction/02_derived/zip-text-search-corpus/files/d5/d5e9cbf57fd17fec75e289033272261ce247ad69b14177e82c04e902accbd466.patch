+def _active_consensus_reference(
+    towow: Path,
+    source_concept_id: str,
+    reference_id: str,
+) -> dict[str, object] | None:
+    """Return one active typed reference owned by ``source_concept_id``.
+
+    Reference migration must be based on the canonical projection rather than a caller's
+    assertion.  This also makes ref-repoint/ref-remove idempotent after an interrupted two-step
+    repoint: a committed add can be reused and an already removed old ref is observable.
+    """
+    event_log = EventLog(towow / "events.log")
+    store = ProjectionStore(towow / "graph")
+    store.catchup(event_log)
+    graph = store.read("at_reference_graph") or {}
+    references = graph.get("references", []) if isinstance(graph, dict) else []
+    for ref in references if isinstance(references, list) else []:
+        if not isinstance(ref, dict):
+            continue
+        if (
+            ref.get("reference_id") == reference_id
+            and ref.get("source_concept_id") == source_concept_id
+            and ref.get("is_active") is True
+        ):
+            return ref
+    return None
+
+
+def _concept_id_from_parsed_reference(parsed_ref: Any) -> str:
+    """Resolve the graph concept id represented by the §4.5 locator parser.
+
+    The parser treats ``@vN`` as a version anchor.  For concept references that anchor is part
+    of the target concept id, while a real event lock is not.
+    """
+    concept_name = str(parsed_ref.concept_name)
+    lock_event_id = parsed_ref.lock_event_id
+    from towow.l1.at_reference_lock import is_version_anchor
+
+    if isinstance(lock_event_id, str) and is_version_anchor(lock_event_id):
+        return f"{concept_name}@{lock_event_id}"
+    return concept_name
+
+
+def _validate_reference_for_repoint(towow: Path, at_reference: str) -> Any:
+    """Parse and validate a new reference against the live event log and concept graph."""
+    from towow.l1.at_reference_lock import lock_validation_errors
+    from towow.schemas.payloads.at_reference_locator import parse as parse_at_ref
+    from towow.schemas.payloads.at_reference_locator import validate as validate_at_ref
+
+    valid, errors = validate_at_ref(at_reference)
+    if not valid:
+        raise click.ClickException(
+            f"@ reference {at_reference!r} 违反 M-1.2 §4.5 typed-id 语法: "
+            + "; ".join(errors)
+        )
+    parsed_ref = parse_at_ref(at_reference)[0]
+    event_log = EventLog(towow / "events.log")
+    store = ProjectionStore(towow / "graph")
+    store.catchup(event_log)
+    concept_graph = store.read("concept_graph") or {}
+    lock_errors = lock_validation_errors(
+        [parsed_ref], event_log=event_log, concept_graph=concept_graph,
+    )
+    if lock_errors:
+        raise click.ClickException(
+            f"@ reference {at_reference!r} 违反 M-1.2 §4.5 lock 事件锁校验: "
+            + "; ".join(lock_errors)
+        )
+    target_id = _concept_id_from_parsed_reference(parsed_ref)
+    nodes_value = concept_graph.get("nodes", []) if isinstance(concept_graph, dict) else []
