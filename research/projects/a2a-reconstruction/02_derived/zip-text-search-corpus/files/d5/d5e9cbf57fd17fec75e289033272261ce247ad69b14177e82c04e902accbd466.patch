index 000000000..5277692c7
--- /dev/null
+++ b/harness/tests/unit/l1/test_consensus_invalidation.py
@@ -0,0 +1,159 @@
+"""Schema-compatibility tests for the consensus supersede invalidation consumer."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import TYPE_CHECKING
+
+from towow.l0.event_log.index import EventIndex, LazyEventIndex
+from towow.l1.consensus_invalidation import active_references_to
+from towow.schemas.enums import (
+    ActorType,
+    BaseClassification,
+    EventCategory,
+    EventType,
+    SubjectEntityType,
+    SubjectRole,
+)
+from towow.schemas.event_intent import Subject, Supersede
+from towow.schemas.event_record import EventRecord, Provenance
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    import pytest
+
+
+def _record(seq: int, event_id: str, event_type: EventType, payload: dict[str, object]) -> EventRecord:
+    return EventRecord(
+        event_id=event_id,
+        sequence_number=seq,
+        timestamp=datetime(2026, 7, 13, tzinfo=UTC),
+        record_hash=f"hash-{seq}",
+        local_intent_id=f"intent-{seq}",
+        event_type=event_type,
+        event_category=EventCategory.STATE_TRANSITION,
+        payload=payload,
+        provenance=Provenance(
+            actor_type=ActorType.AGENT_SESSION.value,
+            actor_id="test",
+            session_id="sess-test",
+            skill_id="M-1.2",
+        ),
+        base_classification=BaseClassification.IMMUTABLE_TRUTH,
+        supersede=Supersede(is_supersede=False),
+        subjects=[
+            Subject(
+                entity_type=SubjectEntityType.AT_REFERENCE,
+                entity_id=f"ref-{seq}",
+                role=SubjectRole.PRIMARY,
+            )
+        ],
+        schema_version="1.0.0",
+    )
+
+
+def test_active_references_fold_canonical_and_legacy_removals(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    towow = tmp_path / ".towow"
+    towow.mkdir()
+    target = "contract-old@v1"
+    canonical_ref = "@concept:contract-old@v1"
+    legacy_ref = "@concept:contract-old@v1#legacy"
+    records = [
+        _record(
+            0,
+            "evt-add-canonical",
+            EventType.AT_REFERENCE_ADDED,
+            {"after_state": {"at_reference": canonical_ref, "target_concept_name": "contract-old"}},
+        ),
+        _record(
+            1,
+            "evt-add-legacy",
+            EventType.AT_REFERENCE_ADDED,
+            {"after_state": {"at_reference": legacy_ref, "target_concept_name": "contract-old"}},
+        ),
+        _record(
+            2,
+            "evt-remove-canonical",
+            EventType.AT_REFERENCE_REMOVED,
+            {"before_state": {"reference_id": canonical_ref}},
+        ),
+        _record(
+            3,
+            "evt-remove-legacy",
+            EventType.AT_REFERENCE_REMOVED,
+            {"after_state": {"at_reference": legacy_ref}},
+        ),
+    ]
+    (towow / "events.log").write_text(
+        "\n".join(record.model_dump_json() for record in records) + "\n",
+        encoding="utf-8",
+    )
+
+    def _forbidden_records(*_args: object, **_kwargs: object) -> list[EventRecord]:
+        raise AssertionError("active reference planning must use type postings, not materialize all records")
+
+    monkeypatch.setattr(EventIndex, "records", _forbidden_records)
+    monkeypatch.setattr(LazyEventIndex, "records", _forbidden_records)
+
+    assert active_references_to(towow, target) == []
+
+
+def test_canonical_removal_is_scoped_to_source_owner(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The same locator held by A and B is two references; removing A must leave B active."""
+    towow = tmp_path / ".towow"
+    towow.mkdir()
+    target = "contract-old@v1"
+    locator = "@concept:contract-old@v1"
+    records = [
+        _record(
+            0,
+            "evt-add-a",
+            EventType.AT_REFERENCE_ADDED,
+            {"after_state": {
+                "source_concept_id": "consumer-a@v1",
+                "at_reference": locator,
+                "target_concept_name": "contract-old",
+            }},
+        ),
+        _record(
+            1,
+            "evt-add-b",
+            EventType.AT_REFERENCE_ADDED,
+            {"after_state": {
+                "source_concept_id": "consumer-b@v1",
+                "at_reference": locator,
+                "target_concept_name": "contract-old",
+            }},
+        ),
+        _record(
+            2,
+            "evt-remove-a",
+            EventType.AT_REFERENCE_REMOVED,
+            {"before_state": {
+                "reference_id": locator,
+                "source_entity": {"type": "concept", "id": "consumer-a@v1"},
+            }},
+        ),
+    ]
+    (towow / "events.log").write_text(
+        "\n".join(record.model_dump_json() for record in records) + "\n",
+        encoding="utf-8",
+    )
+
+    def _forbidden_records(*_args: object, **_kwargs: object) -> list[EventRecord]:
+        raise AssertionError("active reference planning must use type postings")
+
+    monkeypatch.setattr(EventIndex, "records", _forbidden_records)
+    monkeypatch.setattr(LazyEventIndex, "records", _forbidden_records)
+
+    active = active_references_to(towow, target)
+    assert [(ref["source_concept_id"], ref["at_reference"]) for ref in active] == [
+        ("consumer-b@v1", locator),
+    ]
