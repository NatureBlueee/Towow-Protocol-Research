+def _typed_locator_match(entry: dict[str, object], ref_id: object, owner: object) -> bool:
+    """Identity match for a typed-locator (T-L1-14) @ reference projection entry.
+
+    Two independently controlled consumers may share the same ``at_reference`` locator string
+    against the same target; each must stay keyed by (locator, owner) so one consumer's
+    remove/auto-update/target-supersede lifecycle event never mutates the other's still-active
+    entry. ``owner is None`` means the incoming event carries no source_concept_id at all (a
+    pre-owner-scoping legacy record) — degrade to the original locator-only match so already
+    -committed history keeps replaying exactly as it did before (§6 idempotent replay).
+    Endpoint-shaped entries never carry "source_concept_id" and are unaffected by this when
+    their unique reference_id is passed in with owner=None.
+    """
+    if entry.get("reference_id") != ref_id:
+        return False
+    if owner is None:
+        return True
+    return entry.get("source_concept_id", "") == owner
+
