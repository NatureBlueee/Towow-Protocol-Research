{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationReport",
  "type": "object",
  "required": [
    "report_id",
    "artifact",
    "validator",
    "result",
    "findings"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "validator": {
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}