index 0000000..ad7ccf7
--- /dev/null
+++ b/app/_lib/consumer-adoption-runtime.ts
@@ -0,0 +1,148 @@
+import "server-only";
+
+import { createHash } from "node:crypto";
+
+import {
+  ConsumerAuthorityConflictError,
+  ConsumerAuthorityUnavailableError,
+  RecoverableConsumerAuthority,
+  type ConsumerAdoptionReadback,
+  type ExternalReaderHandle,
+  type WorldOutboxDelivery,
+} from "@/core/adoption/recoverable-consumer-authority";
+import { createFoshanAluminumEnterprise } from "@/fixtures/factory-foshan-aluminum/enterprise";
+
+const enterpriseId = createFoshanAluminumEnterprise().id;
+const storePath = process.env.ALLBUDDY_ADOPTION_STORE_PATH;
+const worldClaimCapability = process.env.ALLBUDDY_WORLD_CLAIM_CAPABILITY;
+
+function authority(): RecoverableConsumerAuthority {
+  if (!storePath || !worldClaimCapability) {
+    throw new ConsumerAuthorityUnavailableError();
+  }
+  return new RecoverableConsumerAuthority(storePath);
+}
+
+export interface ProductShellAdoptionOffer {
+  readonly reference: string;
+  readonly operationId: string;
+}
+
+export function isConsumerAuthorityConfigured(): boolean {
+  return Boolean(storePath && worldClaimCapability);
+}
+
+export function prepareProductShellAdoption(input: {
+  readonly operationId: string;
+  readonly tenantSessionCapability: string;
+  readonly taskId: string;
+  readonly artifactId: string;
+  readonly artifact: unknown;
+}): ProductShellAdoptionOffer | undefined {
+  if (!isConsumerAuthorityConfigured()) return undefined;
+  return authority().prepare({
+    operationId: input.operationId,
+    tenantId: enterpriseId,
+    tenantSessionCapability: input.tenantSessionCapability,
+    worldClaimCapability: worldClaimCapability!,
+    taskId: input.taskId,
+    artifactId: input.artifactId,
+    consumerId: "allbuddy:product-shell",
+    artifact: input.artifact,
+  });
+}
+
+export function reviewProductShellArtifact(input: {
+  readonly reference: string;
+  readonly operationId: string;
+  readonly tenantSessionCapability: string;
+}): { readonly artifact: unknown; readonly phase: "artifact_persisted" | "decided" } {
+  return authority().reviewPersistedArtifact(input);
+}
+
+export function recordProductShellAdoption(input: {
+  readonly reference: string;
+  readonly operationId: string;
+  readonly tenantSessionCapability: string;
+}): ConsumerAdoptionReadback {
+  return authority().recordDecision({
+    ...input,
+    state: "adopted",
+    readerViewerId: "agent-world:local-external-acceptance",
+  });
+}
+
+export function readProductShellPostcondition(input: {
+  readonly reference: string;
+  readonly operationId: string;
+  readonly tenantSessionCapability: string;
+}): { readonly artifact: unknown; readonly readback: ConsumerAdoptionReadback } {
+  return authority().readConsumerPostcondition(input);
+}
+
+export function recoverProductShellOperation(input: {
+  readonly operationId: string;
+  readonly tenantSessionCapability: string;
+}) {
+  return authority().recoverOperation(input);
+}
+
+export function reviseProductShellAdoption(input: {
+  readonly reference: string;
+  readonly tenantSessionCapability: string;
+  readonly updateOperationId: string;
+  readonly expectedRevision: number;
+  readonly state: "adopted" | "not_adopted" | "revoked";
+}): ConsumerAdoptionReadback {
+  return authority().revise(input);
+}
+
+export function cancelProductShellAdoption(input: {
+  readonly operationId: string;
+  readonly tenantSessionCapability: string;
+}): ConsumerAdoptionReadback {
+  return authority().cancelOperation({
+    ...input,
+    cancelOperationId: `cancel_${createHash("sha256")
+      .update(input.operationId, "utf8")
+      .digest("hex")
+      .slice(0, 32)}`,
+    readerViewerId: "agent-world:local-external-acceptance",
+  });
+}
+
+export function readExternalAdoption(
+  input: ExternalReaderHandle & { readonly revision: number },
+): ConsumerAdoptionReadback {
+  return authority().read(input);
+}
+
+export function claimWorldOutbox(input: {
+  readonly worldClaimCapability: string;
+  readonly worldId: string;
+  readonly leaseMs: number;
+}): readonly WorldOutboxDelivery[] {
+  return authority().claimWorldOutbox(input);
+}
+
+export function ackWorldOutbox(input: {
+  readonly worldClaimCapability: string;
+  readonly worldId: string;
+  readonly reference: string;
+  readonly eventId: string;
+  readonly leaseToken: string;
+}): void {
+  authority().ackWorldOutbox(input);
+}
+
+export function isConsumerAuthorityUnavailable(
+  error: unknown,
+): error is ConsumerAuthorityUnavailableError {
+  return error instanceof ConsumerAuthorityUnavailableError;
+}
+
+export function isConsumerAuthorityConflict(
+  error: unknown,
+): error is ConsumerAuthorityConflictError {
+  return error instanceof ConsumerAuthorityConflictError;
+}
