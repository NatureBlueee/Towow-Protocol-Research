@@ -0,0 +1,34 @@
+import { NextResponse } from "next/server";
+
+import {
+  CONSUMER_SESSION_COOKIE,
+  ensureConsumerSession,
+} from "@/app/_lib/consumer-adoption-session";
+import { isConsumerAuthorityConfigured } from "@/app/_lib/consumer-adoption-runtime";
+
+export const runtime = "nodejs";
+
+/**
+ * Establish the consumer authority before a recoverable operation starts.
+ *
+ * A run must never be the response that first carries this capability: if that
+ * response is lost, the browser could not authenticate recovery of the record
+ * the server had already prepared.
+ */
+export async function POST(request: Request) {
+  if (!isConsumerAuthorityConfigured()) {
+    return NextResponse.json({ configured: false });
+  }
+  const session = ensureConsumerSession(request);
+  const response = NextResponse.json({ configured: true });
+  if (session.newlyIssued) {
+    response.cookies.set(CONSUMER_SESSION_COOKIE, session.capability, {
+      httpOnly: true,
+      sameSite: "strict",
+      secure: false,
+      path: "/",
+      maxAge: 60 * 60 * 24,
+    });
+  }
+  return response;
+}
