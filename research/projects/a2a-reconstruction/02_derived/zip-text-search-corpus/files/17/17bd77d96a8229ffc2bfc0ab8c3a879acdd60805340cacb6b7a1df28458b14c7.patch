diff --git a/core/adoption/recoverable-consumer-authority.ts b/core/adoption/recoverable-consumer-authority.ts
new file mode 100644
index 0000000..f8b3131
--- /dev/null
+++ b/core/adoption/recoverable-consumer-authority.ts
@@ -0,0 +1,761 @@
+import {
+  createHash,
+  randomBytes,
+  randomUUID,
+  timingSafeEqual,
+} from "node:crypto";
+import {
+  closeSync,
+  existsSync,
+  fsyncSync,
+  linkSync,
+  mkdirSync,
+  openSync,
+  readFileSync,
+  readdirSync,
+  renameSync,
+  statSync,
+  unlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { join } from "node:path";
+
+export type ConsumerAdoptionState = "adopted" | "not_adopted" | "revoked";
+
+export interface ConsumerAdoptionReadback {
+  readonly reference: string;
+  readonly issuer: "allbuddy:consumer-adoption";
+  readonly policy: "local-recoverable-outbox-v3";
+  readonly state: ConsumerAdoptionState;
+  readonly revision: number;
+  readonly observedAt: string;
+}
+
+export interface ExternalReaderHandle {
+  readonly reference: string;
+  readonly viewerId: string;
+  readonly readCapability: string;
+}
+
+export interface WorldOutboxDelivery {
+  readonly eventId: string;
+  readonly reference: string;
+  readonly revision: number;
+  readonly leaseToken: string;
+  readonly lineage: readonly {
+    readonly eventId: string;
+    readonly revision: number;
+  }[];
+  readonly readerHandle: ExternalReaderHandle;
+}
+
+interface StoredRevision {
+  readonly operationId: string;
+  readonly state: ConsumerAdoptionState;
+  readonly revision: number;
+  readonly observedAt: string;
+  readonly expectedRevision?: number;
+}
+
+interface StoredOutboxEntry {
+  readonly eventId: string;
+  readonly revision: number;
+  leaseOwner: string | null;
+  leaseToken: string | null;
+  leaseExpiresAtMs: number | null;
+  ackedAt: string | null;
+  supersededByEventId: string | null;
+}
+
+interface StoredAdoption {
+  readonly version: 3;
+  readonly reference: string;
+  readonly operationId: string;
+  readonly tenantId: string;
+  readonly tenantSessionHash: string;
+  readonly worldClaimHash: string;
+  readonly requestDigest: string;
+  readonly taskId: string;
+  readonly artifactId: string;
+  readonly consumerId: string;
+  readonly artifact: unknown;
+  phase: "prepared" | "artifact_persisted" | "decided";
+  artifactReadAt: string | null;
+  worldReaderHandle: ExternalReaderHandle | null;
+  readonly history: StoredRevision[];
+  readonly outbox: StoredOutboxEntry[];
+}
+
+export class ConsumerAuthorityUnavailableError extends Error {
+  constructor() {
+    super("consumer authority reference is unavailable");
+    this.name = "ConsumerAuthorityUnavailableError";
+  }
+}
+
+export class ConsumerAuthorityConflictError extends Error {
+  constructor() {
+    super("consumer authority revision conflict");
+    this.name = "ConsumerAuthorityConflictError";
+  }
+}
+
+function capability(): string {
+  return randomBytes(32).toString("base64url");
+}
+
+function hash(value: string): string {
+  return createHash("sha256").update(value, "utf8").digest("hex");
+}
+
+function hashMatches(storedHash: string, candidate: string): boolean {
+  const stored = Buffer.from(storedHash, "hex");
+  const actual = Buffer.from(hash(candidate), "hex");
+  return stored.length === actual.length && timingSafeEqual(stored, actual);
+}
+
+function referenceFor(sessionCapability: string, operationId: string): string {
+  const digest = hash(`reference\0${sessionCapability}\0${operationId}`);
+  return `car_${digest.slice(0, 8)}-${digest.slice(8, 12)}-${digest.slice(12, 16)}-${digest.slice(16, 20)}-${digest.slice(20, 32)}`;
+}
+
+function eventId(reference: string, revision: number): string {
+  return `evt_${hash(`${reference}\0${revision}`).slice(0, 32)}`;
+}
+
+function prepareRequestDigest(input: {
+  readonly tenantId: string;
+  readonly worldClaimCapability: string;
+  readonly taskId: string;
+  readonly artifactId: string;
+  readonly consumerId: string;
+  readonly artifact: unknown;
+}): string {
+  return hash(JSON.stringify([
+    input.tenantId,
+    hash(input.worldClaimCapability),
+    input.taskId,
+    input.artifactId,
+    input.consumerId,
+    input.artifact,
+  ]));
+}
+
+function publicReadback(record: StoredAdoption): ConsumerAdoptionReadback {
+  const current = record.history.at(-1);
+  if (current === undefined) throw new ConsumerAuthorityUnavailableError();
+  return publicRevisionReadback(record.reference, current);
+}
+
+function publicRevisionReadback(
+  reference: string,
+  revision: StoredRevision,
+): ConsumerAdoptionReadback {
+  return {
+    reference,
+    issuer: "allbuddy:consumer-adoption",
+    policy: "local-recoverable-outbox-v3",
+    state: revision.state,
+    revision: revision.revision,
+    observedAt: revision.observedAt,
+  };
+}
+
+const REFERENCE_PATTERN = /^car_[0-9a-f-]{36}$/;
+const OPERATION_PATTERN = /^[A-Za-z0-9_-]{8,128}$/;
+const LOCK_WAIT_BUFFER = new Int32Array(new SharedArrayBuffer(4));
+
+/**
+ * Local same-host synthetic authority.
+ *
+ * - prepare is idempotent by authenticated session + caller operationId;
+ * - review, decision and consumer readback use the pre-existing HttpOnly-style
+ *   session capability, not a secret returned by the mutation response;
+ * - adoption/revision and a durable World outbox entry share one atomic record;
+ * - World claims at-least-once, persists independently, then acknowledges.
+ */
+export class RecoverableConsumerAuthority {
+  private readonly recordsDirectory: string;
+  private readonly locksDirectory: string;
+  private readonly nowMs: () => number;
+
+  constructor(
+    rootDirectory: string,
+    nowMs: () => number = () => Date.now(),
+  ) {
+    this.recordsDirectory = join(rootDirectory, "records");
+    this.locksDirectory = join(rootDirectory, "locks");
+    this.nowMs = nowMs;
+    mkdirSync(this.recordsDirectory, { recursive: true });
+    mkdirSync(this.locksDirectory, { recursive: true });
+  }
+
+  prepare(input: {
+    readonly operationId: string;
+    readonly tenantId: string;
+    readonly tenantSessionCapability: string;
+    readonly worldClaimCapability: string;
+    readonly taskId: string;
+    readonly artifactId: string;
+    readonly consumerId: string;
+    readonly artifact: unknown;
+  }): { readonly reference: string; readonly operationId: string } {
+    this.assertOperation(input.operationId);
+    const reference = referenceFor(input.tenantSessionCapability, input.operationId);
+    const requestDigest = prepareRequestDigest(input);
+    return this.withRecordLock(reference, () => {
+      if (existsSync(this.recordPath(reference))) {
+        const existing = this.readRecord(reference);
+        if (
+          existing.operationId !== input.operationId
+          || !hashMatches(existing.tenantSessionHash, input.tenantSessionCapability)
+          || existing.requestDigest !== requestDigest
+        ) {
+          throw new ConsumerAuthorityUnavailableError();
+        }
+        return { reference, operationId: input.operationId };
+      }
+      const record: StoredAdoption = {
+        version: 3,
+        reference,
+        operationId: input.operationId,
+        tenantId: input.tenantId,
+        tenantSessionHash: hash(input.tenantSessionCapability),
+        worldClaimHash: hash(input.worldClaimCapability),
+        requestDigest,
+        taskId: input.taskId,
+        artifactId: input.artifactId,
+        consumerId: input.consumerId,
+        artifact: structuredClone(input.artifact),
+        phase: "prepared",
+        artifactReadAt: null,
+        worldReaderHandle: null,
+        history: [],
+        outbox: [],
+      };
+      this.writeNewRecord(record);
+      return { reference, operationId: input.operationId };
+    });
+  }
+
+  reviewPersistedArtifact(input: {
+    readonly reference: string;
+    readonly operationId: string;
+    readonly tenantSessionCapability: string;
+  }): { readonly artifact: unknown; readonly phase: "artifact_persisted" | "decided" } {
+    return this.withRecordLock(input.reference, () => {
+      const record = this.requireConsumerRecord(input);
+      if (record.phase === "prepared") {
+        record.phase = "artifact_persisted";
+        record.artifactReadAt = this.nowIso();
+        this.writeRecord(record);
+      }
+      return {
+        artifact: structuredClone(record.artifact),
+        phase: record.phase,
+      };
+    });
+  }
+
+  recordDecision(input: {
+    readonly reference: string;
+    readonly operationId: string;
+    readonly tenantSessionCapability: string;
+    readonly state: Exclude<ConsumerAdoptionState, "revoked">;
+    readonly readerViewerId: string;
+  }): ConsumerAdoptionReadback {
+    return this.withRecordLock(input.reference, () => {
+      const record = this.requireConsumerRecord(input);
+      if (record.phase === "prepared") throw new ConsumerAuthorityConflictError();
+      const current = record.history.at(-1);
+      if (current !== undefined) {
+        if (current.operationId !== input.operationId || current.state !== input.state) {
+          throw new ConsumerAuthorityConflictError();
+        }
+        return publicReadback(record);
+      }
+      const readerHandle: ExternalReaderHandle = {
+        reference: record.reference,
+        viewerId: input.readerViewerId,
+        readCapability: capability(),
+      };
+      record.phase = "decided";
+      record.worldReaderHandle = readerHandle;
+      record.history.push({
+        operationId: input.operationId,
+        state: input.state,
+        revision: 1,
+        observedAt: this.nowIso(),
+      });
+      record.outbox.push({
+        eventId: eventId(record.reference, 1),
+        revision: 1,
+        leaseOwner: null,
+        leaseToken: null,
+        leaseExpiresAtMs: null,
+        ackedAt: null,
+        supersededByEventId: null,
+      });
+      this.writeRecord(record);
+      return publicReadback(this.readRecord(record.reference));
+    });
+  }
+
+  readConsumerPostcondition(input: {
+    readonly reference: string;
+    readonly operationId: string;
+    readonly tenantSessionCapability: string;
+  }): { readonly artifact: unknown; readonly readback: ConsumerAdoptionReadback } {
+    const record = this.requireConsumerRecord(input);
+    if (record.phase !== "decided") throw new ConsumerAuthorityUnavailableError();
+    return {
+      artifact: structuredClone(record.artifact),
+      readback: publicReadback(record),
+    };
+  }
+
+  recoverOperation(input: {
+    readonly operationId: string;
+    readonly tenantSessionCapability: string;
+  }): {
+    readonly reference: string;
+    readonly operationId: string;
+    readonly phase: StoredAdoption["phase"];
+    readonly artifact?: unknown;
+    readonly readback?: ConsumerAdoptionReadback;
+  } {
+    this.assertOperation(input.operationId);
+    const reference = referenceFor(
+      input.tenantSessionCapability,
+      input.operationId,
+    );
+    const record = this.requireConsumerRecord({
+      reference,
+      operationId: input.operationId,
+      tenantSessionCapability: input.tenantSessionCapability,
+    });
+    return {
+      reference,
+      operationId: input.operationId,
+      phase: record.phase,
+      ...(record.phase === "prepared" ? {} : { artifact: structuredClone(record.artifact) }),
+      ...(record.phase === "decided" ? { readback: publicReadback(record) } : {}),
+    };
+  }
+
+  revise(input: {
+    readonly reference: string;
+    readonly tenantSessionCapability: string;
+    readonly updateOperationId: string;
+    readonly expectedRevision: number;
+    readonly state: ConsumerAdoptionState;
+  }): ConsumerAdoptionReadback {
+    this.assertOperation(input.updateOperationId);
+    return this.withRecordLock(input.reference, () => {
+      const record = this.requireSessionRecord(
+        input.reference,
+        input.tenantSessionCapability,
+      );
+      const replay = record.history.find((item) => item.operationId === input.updateOperationId);
+      if (replay !== undefined) {
+        if (
+          replay.expectedRevision !== input.expectedRevision
+          || replay.state !== input.state
+        ) {
+          throw new ConsumerAuthorityConflictError();
+        }
+        return publicRevisionReadback(record.reference, replay);
+      }
+      const current = record.history.at(-1);
+      if (current === undefined || current.revision !== input.expectedRevision) {
+        throw new ConsumerAuthorityConflictError();
+      }
+      const nextRevision = current.revision + 1;
+      const nextEventId = eventId(record.reference, nextRevision);
+      record.history.push({
+        operationId: input.updateOperationId,
+        state: input.state,
+        revision: nextRevision,
+        observedAt: this.nowIso(),
+        expectedRevision: input.expectedRevision,
+      });
+      record.outbox.push({
+        eventId: nextEventId,
+        revision: nextRevision,
+        leaseOwner: null,
+        leaseToken: null,
+        leaseExpiresAtMs: null,
+        ackedAt: null,
+        supersededByEventId: null,
+      });
+      this.writeRecord(record);
+      return publicReadback(this.readRecord(record.reference));
+    });
+  }
+
+  cancelOperation(input: {
+    readonly operationId: string;
+    readonly tenantSessionCapability: string;
+    readonly cancelOperationId: string;
+    readonly readerViewerId: string;
+  }): ConsumerAdoptionReadback {
+    this.assertOperation(input.operationId);
+    this.assertOperation(input.cancelOperationId);
+    const reference = referenceFor(
+      input.tenantSessionCapability,
+      input.operationId,
+    );
+    return this.withRecordLock(reference, () => {
+      const record = this.requireConsumerRecord({
+        reference,
+        operationId: input.operationId,
+        tenantSessionCapability: input.tenantSessionCapability,
+      });
+      const replay = record.history.find(
+        (item) => item.operationId === input.cancelOperationId,
+      );
+      if (replay !== undefined) {
+        if (replay.state !== "not_adopted" && replay.state !== "revoked") {
+          throw new ConsumerAuthorityConflictError();
+        }
+        return publicRevisionReadback(record.reference, replay);
+      }
+      const current = record.history.at(-1);
+      const nextState: ConsumerAdoptionState = current === undefined
+        ? "not_adopted"
+        : "revoked";
+      if (current?.state === "revoked" || current?.state === "not_adopted") {
+        return publicReadback(record);
+      }
+      if (record.worldReaderHandle === null) {
+        record.worldReaderHandle = {
+          reference: record.reference,
+          viewerId: input.readerViewerId,
+          readCapability: capability(),
+        };
+      }
+      const nextRevision = (current?.revision ?? 0) + 1;
+      const nextEventId = eventId(record.reference, nextRevision);
+      record.phase = "decided";
+      record.history.push({
+        operationId: input.cancelOperationId,
+        state: nextState,
+        revision: nextRevision,
+        observedAt: this.nowIso(),
+        ...(current === undefined ? {} : { expectedRevision: current.revision }),
+      });
+      for (const pending of record.outbox) {
+        if (
+          pending.ackedAt === null
+          && pending.leaseOwner === null
+          && pending.supersededByEventId === null
+        ) {
+          pending.supersededByEventId = nextEventId;
+        }
+      }
+      record.outbox.push({
+        eventId: nextEventId,
+        revision: nextRevision,
+        leaseOwner: null,
+        leaseToken: null,
+        leaseExpiresAtMs: null,
+        ackedAt: null,
+        supersededByEventId: null,
+      });
+      this.writeRecord(record);
+      return publicRevisionReadback(
+        record.reference,
+        record.history.at(-1)!,
+      );
+    });
+  }
+
+  read(input: ExternalReaderHandle & { readonly revision: number }): ConsumerAdoptionReadback {
+    const record = this.readRecord(input.reference);
+    const handle = record.worldReaderHandle;
+    if (
+      handle === null
+      || handle.viewerId !== input.viewerId
+      || !hashMatches(hash(handle.readCapability), input.readCapability)
+    ) {
+      throw new ConsumerAuthorityUnavailableError();
+    }
+    const revision = record.history.find((item) => item.revision === input.revision);
+    if (revision === undefined) throw new ConsumerAuthorityUnavailableError();
+    return publicRevisionReadback(record.reference, revision);
+  }
+
+  claimWorldOutbox(input: {
+    readonly worldClaimCapability: string;
+    readonly worldId: string;
+    readonly leaseMs: number;
+  }): readonly WorldOutboxDelivery[] {
+    const now = this.nowMs();
+    const deliveries: WorldOutboxDelivery[] = [];
+    for (const reference of this.listReferences()) {
+      const delivery = this.withRecordLock(reference, () => {
+        const record = this.readRecord(reference);
+        if (!hashMatches(record.worldClaimHash, input.worldClaimCapability)) return null;
+        const pending = record.outbox.find((entry) => (
+          entry.ackedAt === null
+          && entry.supersededByEventId === null
+          && (
+            entry.leaseExpiresAtMs === null
+            || entry.leaseExpiresAtMs <= now
+          )
+        ));
+        if (pending === undefined || record.worldReaderHandle === null) return null;
+        pending.leaseOwner = input.worldId;
+        pending.leaseToken = capability();
+        pending.leaseExpiresAtMs = now + input.leaseMs;
+        this.writeRecord(record);
+        return {
+          eventId: pending.eventId,
+          reference: record.reference,
+          revision: pending.revision,
+          leaseToken: pending.leaseToken,
+          lineage: record.outbox
+            .filter((entry) => entry.revision <= pending.revision)
+            .map((entry) => ({
+              eventId: entry.eventId,
+              revision: entry.revision,
+            })),
+          readerHandle: structuredClone(record.worldReaderHandle),
+        };
+      });
+      if (delivery !== null) deliveries.push(delivery);
+    }
+    return deliveries;
+  }
+
+  ackWorldOutbox(input: {
+    readonly worldClaimCapability: string;
+    readonly worldId: string;
+    readonly reference: string;
+    readonly eventId: string;
+    readonly leaseToken: string;
+  }): void {
+    this.withRecordLock(input.reference, () => {
+      const record = this.readRecord(input.reference);
+      if (!hashMatches(record.worldClaimHash, input.worldClaimCapability)) {
+        throw new ConsumerAuthorityUnavailableError();
+      }
+      const entry = record.outbox.find((candidate) => candidate.eventId === input.eventId);
+      if (
+        entry === undefined
+        || entry.leaseOwner !== input.worldId
+        || entry.leaseToken !== input.leaseToken
+      ) {
+        throw new ConsumerAuthorityUnavailableError();
+      }
+      if (entry.ackedAt === null) {
+        entry.ackedAt = this.nowIso();
+        this.writeRecord(record);
+      }
+    });
+  }
+
+  recordCount(): number {
+    return this.listReferences().length;
+  }
+
+  private requireConsumerRecord(input: {
+    readonly reference: string;
+    readonly operationId: string;
+    readonly tenantSessionCapability: string;
+  }): StoredAdoption {
+    const record = this.requireSessionRecord(
+      input.reference,
+      input.tenantSessionCapability,
+    );
+    if (record.operationId !== input.operationId) {
+      throw new ConsumerAuthorityUnavailableError();
+    }
+    return record;
+  }
+
+  private requireSessionRecord(
+    reference: string,
+    tenantSessionCapability: string,
+  ): StoredAdoption {
+    const record = this.readRecord(reference);
+    if (!hashMatches(record.tenantSessionHash, tenantSessionCapability)) {
+      throw new ConsumerAuthorityUnavailableError();
+    }
+    return record;
+  }
+
+  private listReferences(): string[] {
+    return readdirSync(this.recordsDirectory)
+      .filter((name) => name.endsWith(".json"))
+      .map((name) => name.slice(0, -5));
+  }
+
+  private withRecordLock<T>(reference: string, action: () => T): T {
+    this.assertReference(reference);
+    const lockPath = join(this.locksDirectory, `${reference}.lock`);
+    const deadline = Date.now() + 10_000;
+    let descriptor: number | undefined;
+    const ownerToken = randomUUID();
+    while (descriptor === undefined) {
+      try {
+        descriptor = openSync(lockPath, "wx", 0o600);
+        writeFileSync(
+          descriptor,
+          `${JSON.stringify({ pid: process.pid, ownerToken, createdAtMs: Date.now() })}\n`,
+          { encoding: "utf8" },
+        );
+        fsyncSync(descriptor);
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "EEXIST" || Date.now() >= deadline) {
+          throw new ConsumerAuthorityUnavailableError();
+        }
+        this.breakOrphanedLock(lockPath);
+        Atomics.wait(LOCK_WAIT_BUFFER, 0, 0, 5);
+      }
+    }
+    try {
+      return action();
+    } finally {
+      closeSync(descriptor);
+      this.unlinkOwnedLock(lockPath, ownerToken);
+    }
+  }
+
+  private breakOrphanedLock(lockPath: string): void {
+    try {
+      const before = statSync(lockPath);
+      let parsed: { readonly pid?: unknown; readonly ownerToken?: unknown };
+      try {
+        parsed = JSON.parse(readFileSync(lockPath, "utf8")) as typeof parsed;
+      } catch {
+        if (Date.now() - before.mtimeMs >= 1_000) {
+          this.unlinkUnchangedLock(lockPath, before);
+        }
+        return;
+      }
+      if (
+        typeof parsed.pid !== "number"
+        || typeof parsed.ownerToken !== "string"
+        || this.processIsAlive(parsed.pid)
+      ) {
+        return;
+      }
+      this.unlinkUnchangedLock(lockPath, before);
+    } catch {
+      // A live owner may still be initializing the file, or another waiter
+      // may already have removed it. In either case the normal retry loop wins.
+    }
+  }
+
+  private unlinkUnchangedLock(
+    lockPath: string,
+    before: NonNullable<ReturnType<typeof statSync>>,
+  ): void {
+    const after = statSync(lockPath);
+    if (
+      before.ino === after.ino
+      && before.mtimeMs === after.mtimeMs
+      && before.size === after.size
+    ) {
+      unlinkSync(lockPath);
+    }
+  }
+
+  private unlinkOwnedLock(lockPath: string, ownerToken: string): void {
+    try {
+      const parsed = JSON.parse(readFileSync(lockPath, "utf8")) as {
+        readonly ownerToken?: unknown;
+      };
+      if (parsed.ownerToken === ownerToken) unlinkSync(lockPath);
+    } catch {
+      // Never delete a lock that cannot be proven to belong to this holder.
+    }
+  }
+
+  private processIsAlive(pid: number): boolean {
+    if (!Number.isSafeInteger(pid) || pid <= 0) return true;
+    try {
+      process.kill(pid, 0);
+      return true;
+    } catch (error) {
+      return (error as NodeJS.ErrnoException).code !== "ESRCH";
+    }
+  }
+
+  private readRecord(reference: string): StoredAdoption {
+    try {
+      const parsed = JSON.parse(readFileSync(this.recordPath(reference), "utf8")) as StoredAdoption;
+      if (parsed.version !== 3 || parsed.reference !== reference) {
+        throw new ConsumerAuthorityUnavailableError();
+      }
+      return parsed;
+    } catch (error) {
+      if (error instanceof ConsumerAuthorityUnavailableError) throw error;
+      throw new ConsumerAuthorityUnavailableError();
+    }
+  }
+
+  private writeRecord(record: StoredAdoption): void {
+    const temporary = this.writeTemporaryRecord(record);
+    renameSync(temporary, this.recordPath(record.reference));
+    this.fsyncDirectory(this.recordsDirectory);
+  }
+
+  private writeNewRecord(record: StoredAdoption): void {
+    const temporary = this.writeTemporaryRecord(record);
+    try {
+      linkSync(temporary, this.recordPath(record.reference));
+      this.fsyncDirectory(this.recordsDirectory);
+    } finally {
+      try {
+        unlinkSync(temporary);
+      } catch {
+        // The canonical hard link, once created, remains the only authority.
+      }
+    }
+  }
+
+  private writeTemporaryRecord(record: StoredAdoption): string {
+    const temporary = join(
+      this.recordsDirectory,
+      `${record.reference}.${process.pid}.${randomUUID()}.tmp`,
+    );
+    const descriptor = openSync(temporary, "wx", 0o600);
+    try {
+      writeFileSync(descriptor, `${JSON.stringify(record)}\n`, {
+        encoding: "utf8",
+      });
+      fsyncSync(descriptor);
+    } finally {
+      closeSync(descriptor);
+    }
+    return temporary;
+  }
+
+  private fsyncDirectory(directory: string): void {
+    const descriptor = openSync(directory, "r");
+    try {
+      fsyncSync(descriptor);
+    } finally {
+      closeSync(descriptor);
+    }
+  }
+
+  private recordPath(reference: string): string {
+    this.assertReference(reference);
+    return join(this.recordsDirectory, `${reference}.json`);
+  }
+
+  private nowIso(): string {
+    return new Date(this.nowMs()).toISOString();
+  }
+
+  private assertReference(reference: string): void {
+    if (!REFERENCE_PATTERN.test(reference)) throw new ConsumerAuthorityUnavailableError();
+  }
+
+  private assertOperation(operationId: string): void {
+    if (!OPERATION_PATTERN.test(operationId)) throw new ConsumerAuthorityUnavailableError();
+  }
+}
