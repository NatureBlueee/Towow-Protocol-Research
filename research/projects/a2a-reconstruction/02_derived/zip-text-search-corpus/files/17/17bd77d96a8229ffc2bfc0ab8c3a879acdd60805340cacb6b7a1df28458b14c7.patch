+export const CONSUMER_SESSION_COOKIE = "allbuddy_consumer_session_v1";
+
+function cookieValue(request: Request, name: string): string | undefined {
+  const header = request.headers.get("cookie");
+  if (header === null) return undefined;
+  for (const item of header.split(";")) {
+    const [key, ...value] = item.trim().split("=");
+    if (key === name) return decodeURIComponent(value.join("="));
+  }
+  return undefined;
+}
+
+export function readConsumerSession(request: Request): string | undefined {
+  const value = cookieValue(request, CONSUMER_SESSION_COOKIE);
+  return value && value.length >= 32 ? value : undefined;
+}
+
+export function ensureConsumerSession(request: Request): {
+  readonly capability: string;
+  readonly newlyIssued: boolean;
+} {
+  const existing = readConsumerSession(request);
+  if (existing !== undefined) return { capability: existing, newlyIssued: false };
+  return {
+    capability: randomBytes(32).toString("base64url"),
+    newlyIssued: true,
+  };
+}
