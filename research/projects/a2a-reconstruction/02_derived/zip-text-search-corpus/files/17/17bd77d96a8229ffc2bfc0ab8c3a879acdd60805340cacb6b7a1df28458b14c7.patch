index 0000000..2b88f54
--- /dev/null
+++ b/tests/fixtures/adoption-authority-worker.mjs
@@ -0,0 +1,67 @@
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { RecoverableConsumerAuthority } from "../../core/adoption/recoverable-consumer-authority.ts";
+
+const [mode, root, first, second, third, fourth, fifth] = process.argv.slice(2);
+const authority = new RecoverableConsumerAuthority(root);
+
+if (mode === "prepare") {
+  authority.prepare({
+    operationId: `op_worker_${first.padStart(4, "0")}`,
+    tenantId: "tenant-a",
+    tenantSessionCapability: second,
+    worldClaimCapability: third,
+    taskId: `task-${first}`,
+    artifactId: `artifact-${first}`,
+    consumerId: "allbuddy:product-shell",
+    artifact: { id: `artifact-${first}` },
+  });
+  process.stdout.write("success\n");
+} else if (mode === "decide") {
+  const readback = authority.recordDecision({
+    reference: first,
+    operationId: second,
+    tenantSessionCapability: third,
+    state: "adopted",
+    readerViewerId: "agent-world",
+  });
+  process.stdout.write(`${JSON.stringify(readback)}\n`);
+} else if (mode === "world") {
+  const worldStore = first;
+  const worldClaim = second;
+  const worldId = third;
+  const leaseMs = Number(fourth);
+  const ackMode = fifth;
+  mkdirSync(worldStore, { recursive: true });
+  const deliveries = authority.claimWorldOutbox({
+    worldClaimCapability: worldClaim,
+    worldId,
+    leaseMs,
+  });
+  for (const delivery of deliveries) {
+    const target = join(worldStore, `${delivery.eventId}.json`);
+    const { leaseToken: _leaseToken, ...persistedDelivery } = delivery;
+    try {
+      writeFileSync(target, `${JSON.stringify(persistedDelivery)}\n`, { flag: "wx", mode: 0o600 });
+    } catch (error) {
+      if (error.code !== "EEXIST") throw error;
+      const existing = JSON.parse(readFileSync(target, "utf8"));
+      if (JSON.stringify(existing) !== JSON.stringify(persistedDelivery)) {
+        throw new Error("World dedupe collision");
+      }
+    }
+    if (ackMode === "ack") {
+      authority.ackWorldOutbox({
+        worldClaimCapability: worldClaim,
+        worldId,
+        reference: delivery.reference,
+        eventId: delivery.eventId,
+        leaseToken: delivery.leaseToken,
+      });
+    }
+  }
+  process.stdout.write(`${JSON.stringify(deliveries.map((item) => item.eventId))}\n`);
+} else {
+  throw new Error(`unknown worker mode: ${mode}`);
+}
