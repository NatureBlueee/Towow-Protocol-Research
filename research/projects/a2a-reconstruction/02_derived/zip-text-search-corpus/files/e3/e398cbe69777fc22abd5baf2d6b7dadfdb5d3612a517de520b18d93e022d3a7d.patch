+def profile(denied_paths: list[Path]) -> str:
+    rules = ["(version 1)", "(allow default)", "(deny network*)"]
+    for denied in denied_paths:
+        rules.append(f'(deny file-read* (literal "{denied}"))')
+        rules.append(f'(deny file-write* (literal "{denied}"))')
