{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://towow.local/schemas/return_manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "created_at_utc",
    "workspace",
    "git",
    "models_and_agents",
    "flagship_task",
    "files",
    "claim_evidence_file",
    "portable_verification"
  ],
  "properties": {
    "schema_version": {
      "const": "towow-r5-constructive-return-v1"
    },
    "created_at_utc": {
      "type": "string"
    },
    "workspace": {
      "type": "object"
    },
    "git": {
      "type": "object"
    },
    "models_and_agents": {
      "type": "array"
    },
    "flagship_task": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          }
        }
      }
    },
    "claim_evidence_file": {
      "type": "string"
    },
    "portable_verification": {
      "type": "object",
      "required": [
        "relocation_passed",
        "claim_refs_resolved",
        "checksums_passed"
      ],
      "properties": {
        "relocation_passed": {
          "type": "boolean"
        },
        "claim_refs_resolved": {
          "type": "boolean"
        },
        "checksums_passed": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": true
}
