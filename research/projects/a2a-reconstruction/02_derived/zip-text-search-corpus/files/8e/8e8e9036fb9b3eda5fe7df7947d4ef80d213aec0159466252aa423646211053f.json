{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityProfile",
  "type": "object",
  "required": [
    "id",
    "concerns",
    "knowledge_packs",
    "skills",
    "outputs",
    "authority"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "concerns": {
      "type": "array"
    },
    "knowledge_packs": {
      "type": "array"
    },
    "skills": {
      "type": "array"
    },
    "tools": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "authority": {
      "type": "object"
    },
    "known_blind_spots": {
      "type": "array"
    }
  }
}