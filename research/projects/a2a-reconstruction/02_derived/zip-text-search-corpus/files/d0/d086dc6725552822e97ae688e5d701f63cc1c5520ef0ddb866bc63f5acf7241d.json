{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MethodEvent",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "run_id",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "actor": {
      "type": "object"
    },
    "spec_refs": {
      "type": "array"
    },
    "artifact_refs": {
      "type": "array"
    },
    "payload": {
      "type": "object"
    }
  }
}