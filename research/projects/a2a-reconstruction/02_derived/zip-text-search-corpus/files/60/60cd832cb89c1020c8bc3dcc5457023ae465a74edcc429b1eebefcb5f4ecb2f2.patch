+import {
+  closeSync,
+  existsSync,
+  fsyncSync,
+  linkSync,
+  mkdirSync,
+  openSync,
+  readFileSync,
+  readdirSync,
+  renameSync,
+  unlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { createHash, randomUUID } from "node:crypto";
+import { join } from "node:path";
+
+import { ingestEventRecord } from "./ingest.mjs";
+import { mintEventRecordId } from "./ids.mjs";
+import { c1a, c2, c4, canonicalJson } from "./runtimes.mjs";
+
+export const EXTERNAL_ADOPTION_VIEWER = "VIEWER::r5c-external-adoption";
+export const EXTERNAL_ADOPTION_SOURCE_VIEWER = "agent-world:local-external-acceptance";
+const SOURCE_SYSTEM = "allbuddy-consumer-adoption";
+const PROVENANCE = "local_equivalent_real";
+const POLICY = "local-recoverable-outbox-v3";
+const COMPILER_RULE = "RULE::r5c-external-adoption-projection";
+const COMPILER_VERSION = "1.0.0";
+const JOURNAL_VERSION = 1;
+const EVENT_PATTERN = /^evt_[0-9a-f]{32}$/;
+const REFERENCE_PATTERN = /^car_[0-9a-f-]{36}$/;
+const ALLOWED_STATES = new Set(["adopted", "not_adopted", "revoked"]);
+const ALLOWED_OBSERVATION_STATES = new Set(["offline", "stale", "disputed"]);
+const READBACK_KEYS = [
+  "issuer",
+  "observedAt",
+  "policy",
+  "reference",
+  "revision",
+  "state",
+];
+
+function derivedId(namespace, kind, rule, keys) {
+  return c1a.derivedId(namespace, kind, rule, [...keys].map(String));
+}
+
+function canonicalEqual(left, right) {
+  return canonicalJson(left) === canonicalJson(right);
+}
+
+function sha256(value) {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+class ExternalAdoptionDivergenceError extends Error {
+  constructor(evidenceDigests) {
+    super("divergent source identity for reference revision");
+    this.name = "ExternalAdoptionDivergenceError";
+    this.evidenceDigests = [...new Set(evidenceDigests)].sort();
+  }
+}
+
+function safeJournalFiles(directory) {
+  mkdirSync(directory, { recursive: true });
+  return readdirSync(directory)
+    .filter((name) => /^evt_[0-9a-f]{32}\.json$/.test(name))
+    .sort();
+}
+
+function journalPath(directory, eventId) {
+  assert(EVENT_PATTERN.test(eventId), "invalid external adoption eventId");
+  return join(directory, `${eventId}.json`);
+}
+
+function fsyncDirectory(directory) {
+  const descriptor = openSync(directory, "r");
+  try {
+    fsyncSync(descriptor);
+  } finally {
+    closeSync(descriptor);
+  }
+}
+
+function writeAtomicJson(path, value, { exclusive = false } = {}) {
+  const directory = path.slice(0, path.lastIndexOf("/"));
+  const temporary = `${path}.${process.pid}.${randomUUID()}.tmp`;
+  const descriptor = openSync(temporary, "wx", 0o600);
+  try {
+    writeFileSync(descriptor, `${canonicalJson(value)}\n`, { encoding: "utf8" });
+    fsyncSync(descriptor);
+  } finally {
+    closeSync(descriptor);
+  }
+  try {
+    if (exclusive) {
+      // Publishing a hard link is atomic and refuses to replace an existing
+      // immutable event journal. The linked inode was already fsynced above.
+      linkSync(temporary, path);
+      unlinkSync(temporary);
+    } else {
+      renameSync(temporary, path);
+    }
+    fsyncDirectory(directory);
+  } catch (error) {
+    try {
+      unlinkSync(temporary);
+    } catch {
+      // Preserve the original publication failure.
+    }
+    throw error;
+  }
+}
+
+function readJournal(path) {
+  const journal = JSON.parse(readFileSync(path, "utf8"));
+  assert(journal.version === JOURNAL_VERSION, "unsupported external adoption journal");
+  return journal;
+}
+
+function validateReadback(readback, reference, revision) {
+  assert(readback !== null && typeof readback === "object" && !Array.isArray(readback), "invalid readback");
+  assert(
+    canonicalEqual(Object.keys(readback).sort(), READBACK_KEYS),
+    "external adoption readback contains non-public fields",
+  );
+  assert(readback.reference === reference, "readback reference mismatch");
+  assert(readback.issuer === "allbuddy:consumer-adoption", "readback issuer mismatch");
+  assert(readback.policy === POLICY, "readback policy mismatch");
+  assert(readback.revision === revision, "readback revision mismatch");
+  assert(ALLOWED_STATES.has(readback.state), "readback state invalid");
+  assert(!Number.isNaN(Date.parse(readback.observedAt)), "readback observedAt invalid");
+}
+
+function validateDelivery(delivery) {
+  assert(delivery !== null && typeof delivery === "object", "delivery missing");
+  assert(EVENT_PATTERN.test(delivery.eventId), "delivery eventId invalid");
+  assert(REFERENCE_PATTERN.test(delivery.reference), "delivery reference invalid");
+  assert(Number.isInteger(delivery.revision) && delivery.revision > 0, "delivery revision invalid");
+  assert(typeof delivery.leaseToken === "string" && delivery.leaseToken.length >= 16, "lease token missing");
+  assert(delivery.readerHandle?.reference === delivery.reference, "reader reference mismatch");
+  assert(typeof delivery.readerHandle?.viewerId === "string", "reader viewer missing");
+  assert(typeof delivery.readerHandle?.readCapability === "string", "reader capability missing");
+  assert(Array.isArray(delivery.lineage) && delivery.lineage.length > 0, "lineage missing");
+  const seenEvents = new Set();
+  for (let index = 0; index < delivery.lineage.length; index += 1) {
+    const item = delivery.lineage[index];
+    assert(item.revision === index + 1, "lineage must be a contiguous prefix");
+    assert(EVENT_PATTERN.test(item.eventId), "lineage eventId invalid");
+    assert(!seenEvents.has(item.eventId), "lineage eventId reused");
+    seenEvents.add(item.eventId);
+  }
+  const last = delivery.lineage.at(-1);
+  assert(last.revision === delivery.revision && last.eventId === delivery.eventId, "claim is not lineage tail");
+}
+
+function adapterId() {
+  return derivedId("adapter", "adapter", "R5C_ADAPTER::allbuddy_external_adoption", [SOURCE_SYSTEM]);
+}
+
+function adapterSnapshotFor(reference, lineageItem, observedAt) {
+  return {
+    id: derivedId(
+      "adapter-snapshot",
+      "adapter_snapshot",
+      "R5C_ADAPTER_SNAPSHOT::source_observation",
+      [reference, lineageItem.eventId, String(lineageItem.revision), observedAt],
+    ),
+    adapterId: adapterId(),
+    executionProvenance: PROVENANCE,
+    capabilities: [
+      "external.consumer-adoption.claim",
+      "external.consumer-adoption.readback",
+    ],
+    health: "healthy",
+    coverage: "unknown",
+    partialReason: "Single-host synthetic Allbuddy source; no production tenant, deployment, or business-value coverage.",
+    asOf: observedAt,
+    lastEventAt: observedAt,
+    lagMs: 0,
+    schemaVersion: "1.0.0",
+  };
+}
+
+function statusAdapterSnapshot(reference, status, observedAt, observationId) {
+  return {
+    id: derivedId(
+      "adapter-snapshot",
+      "adapter_snapshot",
+      "R5C_ADAPTER_SNAPSHOT::source_status",
+      [reference, status, observedAt, observationId],
+    ),
+    adapterId: adapterId(),
+    executionProvenance: PROVENANCE,
+    capabilities: [
+      "external.consumer-adoption.claim",
+      "external.consumer-adoption.readback",
+    ],
+    health: status === "offline" ? "offline" : "degraded",
+    coverage: status === "stale" ? "stale" : "unknown",
+    partialReason: status === "disputed"
+      ? "Conflicting source evidence requires reconciliation; no source value is selected by the adapter."
+      : `External adoption source observed ${status}; the last accepted value is retained only as stale evidence.`,
+    asOf: observedAt,
+    lastEventAt: observedAt,
+    lagMs: 0,
+    schemaVersion: "1.0.0",
+  };
+}
+
+function claimEntity(reference) {
+  return {
+    id: derivedId("entity", "claim", "R5C_ENTITY::external_adoption_claim", [reference]),
+    stableKey: `allbuddy-consumer-adoption:${reference}`,
+    onticType: "TYPE::InformationObject",
+    kind: "claim",
+    contextRoleBindingRefs: [],
+    facetRefs: [],
+    schemaVersion: "1.0.0",
+    identity: {
+      name: `Allbuddy consumer-adoption report ${reference}`,
+      aliases: [],
+      externalRefs: [{ sourceSystem: SOURCE_SYSTEM, externalId: reference }],
+    },
+    capabilityRefs: [],
+    interfaceRefs: [],
+    resourceRefs: [],
+    policyRefs: [],
+    tags: ["synthetic-local", "consumer-adoption-report"],
+    sourceRefs: [`${SOURCE_SYSTEM}:${reference}`],
+    evidenceRefs: [],
+  };
+}
+
+function eventInput(reference, lineageItem, readback, snapshot, previousRecordId) {
+  return {
+    recordType: "REC::external.consumer_adoption",
+    schemaVersion: "1.0.0",
+    source: {
+      system: SOURCE_SYSTEM,
+      adapterId: snapshot.adapterId.canonical,
+      adapterSnapshotId: snapshot.id.canonical,
+      executionProvenance: PROVENANCE,
+      externalRecordId: lineageItem.eventId,
+      sourceSequence: String(lineageItem.revision),
+    },
+    time: {
+      occurredAt: readback.observedAt,
+      recordedAt: readback.observedAt,
+      ingestedAt: readback.observedAt,
+    },
+    targetIds: [claimEntity(reference).id.canonical],
+    correlation: {},
+    authority: "source",
+    visibilityClass: "restricted",
+    payload: structuredClone(readback),
+    ...(previousRecordId === undefined ? {} : {
+      correction: {
+        correctsRecordId: previousRecordId,
+        reason: `Source revision ${lineageItem.revision} supersedes revision ${lineageItem.revision - 1}.`,
+      },
+    }),
+  };
+}
+
+function completeEventEnvelope(input) {
+  const checksum = c2.eventRecordChecksum(input.payload);
+  return {
+    id: mintEventRecordId(input.source, checksum, input.time.occurredAt),
+    ...input,
+    checksum,
+  };
+}
+
+function immutableCore(delivery) {
+  return {
+    eventId: delivery.eventId,
+    reference: delivery.reference,
+    revision: delivery.revision,
+    lineage: delivery.lineage.map(({ eventId, revision }) => ({ eventId, revision })),
+  };
+}
+
+function nextJournalSequence(directory) {
+  const journals = safeJournalFiles(directory).map((name) => readJournal(join(directory, name)));
+  return journals.reduce((maximum, journal) => Math.max(maximum, journal.journalSequence ?? 0), 0) + 1;
+}
+
+export function stageExternalAdoptionBatch(
+  journalDirectory,
+  delivery,
+  readbacks,
+) {
+  validateDelivery(delivery);
+  assert(Array.isArray(readbacks) && readbacks.length === delivery.lineage.length, "lineage readbacks incomplete");
+  for (let index = 0; index < delivery.lineage.length; index += 1) {
+    validateReadback(
+      readbacks[index],
+      delivery.reference,
+      delivery.lineage[index].revision,
+    );
+  }
+
+  const acceptedJournals = safeJournalFiles(journalDirectory)
+    .map((name) => readJournal(join(journalDirectory, name)))
+    .filter((journal) => journal.kind === "accepted_lineage"
+      && journal.core.reference === delivery.reference);
+  for (let index = 0; index < delivery.lineage.length; index += 1) {
+    const lineageItem = delivery.lineage[index];
+    const incomingEvidence = {
+      eventId: lineageItem.eventId,
+      readback: readbacks[index],
+    };
+    const incomingDigest = sha256(canonicalJson(incomingEvidence));
+    for (const journal of acceptedJournals) {
+      const existingIndex = journal.core.lineage.findIndex(
+        (item) => item.revision === lineageItem.revision,
+      );
+      if (existingIndex === -1) continue;
+      const existingEvidence = {
+        eventId: journal.core.lineage[existingIndex].eventId,
+        readback: journal.readbacks[existingIndex],
+      };
+      if (!canonicalEqual(existingEvidence, incomingEvidence)) {
+        throw new ExternalAdoptionDivergenceError([
+          sha256(canonicalJson(existingEvidence)),
+          incomingDigest,
+        ]);
+      }
+    }
+  }
+  const core = immutableCore(delivery);
+  const target = journalPath(journalDirectory, delivery.eventId);
+
+  const snapshots = [];
+  const eventInputs = [];
+  const eventEnvelopes = [];
+  let previousRecordId;
+  for (let index = 0; index < delivery.lineage.length; index += 1) {
+    const lineageItem = delivery.lineage[index];
+    const readback = readbacks[index];
+    const snapshot = adapterSnapshotFor(delivery.reference, lineageItem, readback.observedAt);
+    const input = eventInput(delivery.reference, lineageItem, readback, snapshot, previousRecordId);
+    const envelope = completeEventEnvelope(input);
+    snapshots.push(snapshot);
+    eventInputs.push(input);
+    eventEnvelopes.push(envelope);
+    previousRecordId = envelope.id.canonical;
+  }
+
+  const staged = {
+    version: JOURNAL_VERSION,
+    kind: "accepted_lineage",
+    journalSequence: nextJournalSequence(journalDirectory),
+    core,
+    readbacks: structuredClone(readbacks),
+    adapterSnapshots: snapshots,
+    claimEntity: claimEntity(delivery.reference),
+    eventInputs,
+    eventEnvelopes,
+    semantic: null,
+    transport: { phase: "staged", ackConfirmed: false },
+  };
+
+  if (existsSync(target)) {
+    const existing = readJournal(target);
+    const comparableExisting = {
+      core: existing.core,
+      readbacks: existing.readbacks,
+      adapterSnapshots: existing.adapterSnapshots,
+      claimEntity: existing.claimEntity,
+      eventInputs: existing.eventInputs,
+      eventEnvelopes: existing.eventEnvelopes,
+    };
+    const comparableStaged = {
+      core: staged.core,
+      readbacks: staged.readbacks,
+      adapterSnapshots: staged.adapterSnapshots,
+      claimEntity: staged.claimEntity,
+      eventInputs: staged.eventInputs,
+      eventEnvelopes: staged.eventEnvelopes,
+    };
+    assert(canonicalEqual(comparableExisting, comparableStaged), "divergent content for staged eventId");
+    return existing;
+  }
+
+  writeAtomicJson(target, staged, { exclusive: true });
+  return staged;
+}
+
+export function stageExternalAdoptionStatusObservation(
+  journalDirectory,
+  {
+    reference,
+    status,
+    observedAt,
+    evidenceDigests = [],
+  },
+) {
+  assert(REFERENCE_PATTERN.test(reference), "status observation reference invalid");
+  assert(ALLOWED_OBSERVATION_STATES.has(status), "status observation state invalid");
+  assert(!Number.isNaN(Date.parse(observedAt)), "status observation observedAt invalid");
+  assert(Array.isArray(evidenceDigests), "status observation evidenceDigests invalid");
+  for (const digest of evidenceDigests) {
+    assert(/^[0-9a-f]{64}$/.test(digest), "status observation evidence digest invalid");
+  }
+  const observationId = `evt_${sha256(canonicalJson({
+    reference,
+    status,
+    observedAt,
+    evidenceDigests,
+  })).slice(0, 32)}`;
+  const target = journalPath(journalDirectory, observationId);
+  const snapshot = statusAdapterSnapshot(reference, status, observedAt, observationId);
+  const core = {
+    eventId: observationId,
+    reference,
+    status,
+    observedAt,
+    evidenceDigests: [...evidenceDigests],
+  };
+  const staged = {
+    version: JOURNAL_VERSION,
+    kind: "status_observation",
+    journalSequence: nextJournalSequence(journalDirectory),
+    core,
+    adapterSnapshots: [snapshot],
+    semantic: null,
+    transport: { phase: "staged", ackConfirmed: false },
+  };
+  if (status === "disputed") {
+    const input = {
+      recordType: "REC::external.consumer_adoption.reconciliation",
+      schemaVersion: "1.0.0",
+      source: {
+        system: `${SOURCE_SYSTEM}:reconciliation`,
+        adapterId: snapshot.adapterId.canonical,
+        adapterSnapshotId: snapshot.id.canonical,
+        executionProvenance: PROVENANCE,
+        externalRecordId: observationId,
+        sourceSequence: observedAt,
+      },
+      time: {
+        occurredAt: observedAt,
+        recordedAt: observedAt,
+        ingestedAt: observedAt,
+      },
+      targetIds: [claimEntity(reference).id.canonical],
+      correlation: {},
+      authority: "reconciliation",
+      visibilityClass: "restricted",
+      payload: {
+        reference,
+        status,
+        evidenceDigests: [...evidenceDigests],
+      },
+    };
+    staged.reconciliationInput = input;
+    staged.reconciliationEnvelope = completeEventEnvelope(input);
+  }
+  if (existsSync(target)) {
+    const existing = readJournal(target);
+    assert(canonicalEqual(
+      {
+        core: existing.core,
+        adapterSnapshots: existing.adapterSnapshots,
+        reconciliationInput: existing.reconciliationInput,
+        reconciliationEnvelope: existing.reconciliationEnvelope,
+      },
+      {
+        core: staged.core,
+        adapterSnapshots: staged.adapterSnapshots,
+        reconciliationInput: staged.reconciliationInput,
+        reconciliationEnvelope: staged.reconciliationEnvelope,
+      },
+    ), "divergent status observation");
+    return existing;
+  }
+  writeAtomicJson(target, staged, { exclusive: true });
+  return staged;
+}
+
+function commitAdapterSnapshot(store, snapshot) {
+  const existing = store.list("adapterSnapshots").find((item) => item.id.canonical === snapshot.id.canonical);
+  if (existing !== undefined) {
+    assert(canonicalEqual(existing, snapshot), "adapter snapshot replay diverged");
+    return;
+  }
+  const next = [...store.list("adapterSnapshots"), snapshot];
+  assert(c2.validateAdapterSnapshotStore({ ...store.snapshot(), adapterSnapshots: next }), "adapter snapshot store invalid");
+  store.commitCollection("adapterSnapshots", next);
+}
+
+function commitClaimEntity(store, entity) {
+  const existing = store.list("entities").find((item) => item.id.canonical === entity.id.canonical);
+  if (existing !== undefined) {
+    assert(canonicalEqual(existing, entity), "claim entity replay diverged");
+    return;
+  }
+  const next = [...store.list("entities"), entity];
+  assert(c1a.validateAgencyStore({ ...store.snapshot(), entities: next }), "claim entity store invalid");
+  store.commitCollection("entities", next);
+}
+
+function ingestExactEnvelope(store, input, expectedEnvelope) {
+  const result = ingestEventRecord(store, input);
+  assert(result.outcome === "ingested" || result.outcome === "duplicate", `EventRecord ingest failed: ${result.reason ?? "unknown"}`);
+  assert(canonicalEqual(result.record, expectedEnvelope), "EventRecord replay bytes diverged");
+  return result.record;
+}
+
+function projectionId(reference) {
+  return derivedId("world-projection", "claim_projection", "R5C_PROJECTION::claim_current", [reference]);
+}
+
+function sceneDeltaId(reference, eventId) {
+  return derivedId("scene-delta", "scene_delta", "R5C_DELTA::claim_revision", [reference, eventId]);
+}
+
+function sourceRef(eventRecord) {
+  return {
+    adapterSnapshotId: eventRecord.source.adapterSnapshotId,
+    executionProvenance: eventRecord.source.executionProvenance,
+    sourceSystem: eventRecord.source.system,
+    externalRecordId: eventRecord.source.externalRecordId,
+    checksum: eventRecord.checksum,
+    capturedAt: eventRecord.time.recordedAt,
+  };
+}
+
+function assertProvenanceJoin(snapshot, eventRecord, ref) {
+  assert(eventRecord.source.adapterSnapshotId === snapshot.id.canonical, "event snapshot join mismatch");
+  assert(eventRecord.source.adapterId === snapshot.adapterId.canonical, "event adapter join mismatch");
+  assert(eventRecord.source.executionProvenance === snapshot.executionProvenance, "event provenance mismatch");
+  assert(ref.adapterSnapshotId === snapshot.id.canonical, "SourceRef snapshot mismatch");
+  assert(ref.executionProvenance === eventRecord.source.executionProvenance, "SourceRef provenance mismatch");
+  assert(ref.sourceSystem === eventRecord.source.system, "SourceRef sourceSystem mismatch");
+  assert(ref.externalRecordId === eventRecord.source.externalRecordId, "SourceRef externalRecordId mismatch");
+  assert(ref.checksum === eventRecord.checksum, "SourceRef checksum mismatch");
+}
+
+function buildProjection(journal, eventRecord, awirRevision) {
+  const current = journal.readbacks.at(-1);
+  const ref = sourceRef(eventRecord);
+  const snapshot = journal.adapterSnapshots.at(-1);
+  assertProvenanceJoin(snapshot, eventRecord, ref);
+  return {
+    id: projectionId(journal.core.reference),
+    archetypeRef: "ARCHETYPE::external-consumer-adoption-claim",
+    semanticAuthority: "authoritative",
+    binding: {
+      semanticEntityIds: [journal.claimEntity.id.canonical],
+      semanticRelationIds: [],
+      occurrenceIds: [],
+      eventRecordIds: [eventRecord.id.canonical],
+      commandIds: [],
+      compilerRuleIds: [`${COMPILER_RULE}@${COMPILER_VERSION}`],
+      compilerVersion: COMPILER_VERSION,
+      sourceRefs: [ref],
+      assetPackVersion: "1.0.0",
+      projectionVersion: "1.0.0",
+      knownSemanticLoss: [
+        "Synthetic automatic-adoption policy; not human/customer adoption.",
+        "Recovery authority is bounded to the local 24-hour consumer session.",
+      ],
+      awirRevision,
+    },
+    humanNarrative: `Synthetic local Allbuddy source reports ${current.state} for an opaque consumer-adoption claim at revision ${current.revision}.`,
+    stateModifiers: [
+      { channel: "consumer_adoption_state", value: current.state, sourceRef: eventRecord.id.canonical },
+      { channel: "source_revision", value: current.revision, sourceRef: eventRecord.id.canonical },
+      { channel: "epistemic", value: "source_reported", sourceRef: eventRecord.id.canonical },
+      { channel: "sync", value: "in_sync", sourceRef: eventRecord.id.canonical },
+    ],
+    compilerRuleVersion: COMPILER_VERSION,
+    awirRevision,
+  };
+}
+
+function buildStatusProjection(journal, existingProjection, reconciliationRecord, awirRevision) {
+  const status = journal.core.status;
+  const snapshot = journal.adapterSnapshots[0];
+  const statusRef = reconciliationRecord === undefined
+    ? {
+      adapterSnapshotId: snapshot.id.canonical,
+      executionProvenance: snapshot.executionProvenance,
+      sourceSystem: SOURCE_SYSTEM,
+      externalRecordId: journal.core.eventId,
+      checksum: sha256(canonicalJson(journal.core)),
+      capturedAt: journal.core.observedAt,
+    }
+    : sourceRef(reconciliationRecord);
+  if (reconciliationRecord !== undefined) {
+    assertProvenanceJoin(snapshot, reconciliationRecord, statusRef);
+  }
+  const epistemic = status === "disputed" ? "disputed" : "unknown";
+  const sync = status === "disputed" ? "reconciliation_required" : status;
+  const statusSourceRef = reconciliationRecord?.id.canonical ?? snapshot.id.canonical;
+  const currentState = existingProjection.stateModifiers.find(
+    (item) => item.channel === "consumer_adoption_state",
+  )?.value;
+  const currentRevision = existingProjection.stateModifiers.find(
+    (item) => item.channel === "source_revision",
+  )?.value;
+  assert(currentState !== undefined && Number.isInteger(currentRevision), "status projection lacks prior source state");
+  return {
+    ...structuredClone(existingProjection),
+    binding: {
+      ...structuredClone(existingProjection.binding),
+      eventRecordIds: [
+        ...new Set([
+          ...existingProjection.binding.eventRecordIds,
+          ...(reconciliationRecord === undefined ? [] : [reconciliationRecord.id.canonical]),
+        ]),
+      ],
+      sourceRefs: [
+        ...existingProjection.binding.sourceRefs,
+        statusRef,
+      ],
+      knownSemanticLoss: [
+        ...existingProjection.binding.knownSemanticLoss,
+        `Source status ${status} observed at ${journal.core.observedAt}; the prior source value is not treated as current.`,
+      ],
+      awirRevision,
+    },
+    humanNarrative: status === "disputed"
+      ? `Conflicting evidence disputes the synthetic local Allbuddy adoption report at source revision ${currentRevision}; reconciliation is required.`
+      : `The synthetic local Allbuddy adoption source is ${status}; its last report (${currentState}, revision ${currentRevision}) is retained only as non-current evidence.`,
+    stateModifiers: [
+      ...existingProjection.stateModifiers.filter(
+        (item) => item.channel !== "epistemic" && item.channel !== "sync",
+      ),
+      { channel: "epistemic", value: epistemic, sourceRef: statusSourceRef },
+      { channel: "sync", value: sync, sourceRef: statusSourceRef },
+    ],
+    awirRevision,
+  };
+}
+
+function advanceCounterTo(store, kind, viewerRef, expectedPre, expectedPost) {
+  const current = kind === "awir"
+    ? store.currentAwirRevision()
+    : store.currentSceneRevision(viewerRef);
+  if (current === expectedPost) return;
+  assert(current === expectedPre, `${kind} counter replay mismatch`);
+  const advanced = kind === "awir"
+    ? store.nextAwirRevision()
+    : store.nextSceneRevision(viewerRef).nextRevision;
+  assert(advanced === expectedPost, `${kind} counter advance mismatch`);
+}
+
+function reconcileAcceptedJournal(store, journal, path, viewerRef) {
+  for (const snapshot of journal.adapterSnapshots) commitAdapterSnapshot(store, snapshot);
+  commitClaimEntity(store, journal.claimEntity);
+  for (let index = 0; index < journal.eventInputs.length; index += 1) {
+    ingestExactEnvelope(store, journal.eventInputs[index], journal.eventEnvelopes[index]);
+  }
+  const currentEvent = store.list("eventRecords").find(
+    (record) => record.id.canonical === journal.eventEnvelopes.at(-1).id.canonical,
+  );
+  assert(currentEvent !== undefined, "current EventRecord missing after ingest");
+
+  const existingProjection = store.list("worldProjections").find(
+    (projection) => projection.id.canonical === projectionId(journal.core.reference).canonical,
+  );
+  const existingSourceRevision = existingProjection?.stateModifiers?.find(
+    (item) => item.channel === "source_revision",
+  )?.value;
+  const desiredEventId = currentEvent.id.canonical;
+  const alreadyCurrent = existingProjection?.binding.eventRecordIds[0] === desiredEventId
+    && existingProjection.stateModifiers?.some(
+      (item) => item.channel === "sync" && item.value === "in_sync",
+    );
+  const supersededByLaterJournal = (
+    Number.isInteger(existingSourceRevision)
+    && existingSourceRevision > journal.core.revision
+  ) || (
+    journal.semantic !== null
+    && existingProjection?.awirRevision > journal.semantic.awirPost
+  );
+
+  if (supersededByLaterJournal) {
+    assert(journal.semantic !== null, "superseded journal semantic postcondition missing");
+    const historicalProjection = buildProjection(
+      journal,
+      currentEvent,
+      journal.semantic.awirPost,
+    );
+    const historicalDelta = {
+      id: sceneDeltaId(journal.core.reference, journal.core.eventId),
+      viewerRef,
+      baseRevision: journal.semantic.scenePre,
+      nextRevision: journal.semantic.scenePost,
+      created: journal.semantic.deltaKind === "created" ? [historicalProjection] : [],
+      updated: journal.semantic.deltaKind === "updated"
+        ? [historicalProjection.id.canonical]
+        : [],
+      removed: [],
+      emittedAt: currentEvent.time.recordedAt,
+    };
+    const existingHistoricalDelta = store.list("sceneDeltas").find(
+      (item) => item.id.canonical === historicalDelta.id.canonical,
+    );
+    if (existingHistoricalDelta === undefined) {
+      assert(c4.validateSceneDelta(historicalDelta), "historical SceneDelta invalid");
+      const nextDeltas = [...store.list("sceneDeltas"), historicalDelta];
+      assert(
+        c4.validateSceneDeltaStore({ ...store.snapshot(), sceneDeltas: nextDeltas }),
+        "historical SceneDelta store invalid",
+      );
+      store.commitCollection("sceneDeltas", nextDeltas);
+    } else {
+      assert(canonicalEqual(existingHistoricalDelta, historicalDelta), "historical SceneDelta replay diverged");
+    }
+    journal.transport.phase = journal.transport.ackConfirmed
+      ? "ack_confirmed"
+      : "ack_pending";
+    writeAtomicJson(path, journal);
+    return {
+      eventId: journal.core.eventId,
+      reference: journal.core.reference,
+      revision: journal.core.revision,
+      projectionId: existingProjection.id.canonical,
+      ackReady: true,
+      superseded: true,
+    };
+  }
+
+  if (journal.semantic === null) {
+    const awirPre = store.currentAwirRevision();
+    const scenePre = store.currentSceneRevision(viewerRef);
+    journal.semantic = {
+      awirPre,
+      awirPost: awirPre + 1,
+      scenePre,
+      scenePost: scenePre + 1,
+      deltaKind: existingProjection === undefined ? "created" : "updated",
+      projectionId: projectionId(journal.core.reference).canonical,
+      deltaId: sceneDeltaId(journal.core.reference, journal.core.eventId).canonical,
+    };
+    writeAtomicJson(path, journal);
+  }
+
+  advanceCounterTo(store, "awir", viewerRef, journal.semantic.awirPre, journal.semantic.awirPost);
+  const projection = buildProjection(journal, currentEvent, journal.semantic.awirPost);
+  if (!alreadyCurrent) {
+    assert(c4.validateWorldProjection(projection), "external adoption projection invalid");
+    const nextProjections = [
+      ...store.list("worldProjections").filter(
+        (item) => item.id.canonical !== projection.id.canonical,
+      ),
+      projection,
+    ];
+    assert(
+      c4.validateWorldProjectionStore({ ...store.snapshot(), worldProjections: nextProjections }),
+      "external adoption projection store invalid",
+    );
+    store.commitCollection("worldProjections", nextProjections);
+  } else {
+    assert(canonicalEqual(existingProjection, projection), "current projection replay diverged");
+  }
+
+  advanceCounterTo(store, "scene", viewerRef, journal.semantic.scenePre, journal.semantic.scenePost);
+  const delta = {
+    id: sceneDeltaId(journal.core.reference, journal.core.eventId),
+    viewerRef,
+    baseRevision: journal.semantic.scenePre,
+    nextRevision: journal.semantic.scenePost,
+    created: journal.semantic.deltaKind === "created" ? [projection] : [],
+    updated: journal.semantic.deltaKind === "updated" ? [projection.id.canonical] : [],
+    removed: [],
+    emittedAt: currentEvent.time.recordedAt,
+  };
+  const existingDelta = store.list("sceneDeltas").find(
+    (item) => item.id.canonical === delta.id.canonical,
+  );
+  if (existingDelta === undefined) {
+    assert(c4.validateSceneDelta(delta), "external adoption SceneDelta invalid");
+    const nextDeltas = [...store.list("sceneDeltas"), delta];
+    assert(
+      c4.validateSceneDeltaStore({ ...store.snapshot(), sceneDeltas: nextDeltas }),
+      "external adoption SceneDelta store invalid",
+    );
+    store.commitCollection("sceneDeltas", nextDeltas);
+  } else {
+    assert(canonicalEqual(existingDelta, delta), "SceneDelta replay diverged");
+  }
+
+  assert(store.currentAwirRevision() === journal.semantic.awirPost, "ack-ready AWIR counter missing");
+  assert(store.currentSceneRevision(viewerRef) === journal.semantic.scenePost, "ack-ready scene counter missing");
+  assert(store.list("sceneDeltas").some(
+    (item) => item.id.canonical === journal.semantic.deltaId,
+  ), "ack-ready SceneDelta missing");
+  journal.transport.phase = journal.transport.ackConfirmed
+    ? "ack_confirmed"
+    : "ack_pending";
+  writeAtomicJson(path, journal);
+  return {
+    eventId: journal.core.eventId,
+    reference: journal.core.reference,
+    revision: journal.core.revision,
+    projectionId: journal.semantic.projectionId,
+    ackReady: true,
+  };
+}
+
+function reconcileStatusJournal(store, journal, path, viewerRef) {
+  const snapshot = journal.adapterSnapshots[0];
+  commitAdapterSnapshot(store, snapshot);
+  const existingProjection = store.list("worldProjections").find(
+    (projection) => projection.id.canonical === projectionId(journal.core.reference).canonical,
+  );
+  if (existingProjection === undefined) {
+    journal.transport.phase = "observed_no_projection";
+    writeAtomicJson(path, journal);
+    return {
+      eventId: journal.core.eventId,
+      reference: journal.core.reference,
+      status: journal.core.status,
+      projectionId: null,
+      ackReady: false,
+      noProjection: true,
+    };
+  }
+
+  let reconciliationRecord;
+  if (journal.core.status === "disputed") {
+    reconciliationRecord = ingestExactEnvelope(
+      store,
+      journal.reconciliationInput,
+      journal.reconciliationEnvelope,
+    );
+  }
+  const statusSourceRef = reconciliationRecord?.id.canonical ?? snapshot.id.canonical;
+  const alreadyCurrent = existingProjection.stateModifiers.some(
+    (item) => item.channel === "epistemic"
+      && item.sourceRef === statusSourceRef,
+  );
+  const supersededByLaterJournal = journal.semantic !== null
+    && existingProjection.awirRevision > journal.semantic.awirPost;
+  if (supersededByLaterJournal) {
+    journal.transport.phase = "observed";
+    writeAtomicJson(path, journal);
+    return {
+      eventId: journal.core.eventId,
+      reference: journal.core.reference,
+      status: journal.core.status,
+      projectionId: existingProjection.id.canonical,
+      ackReady: false,
+      superseded: true,
+    };
+  }
+
+  if (journal.semantic === null) {
+    const awirPre = store.currentAwirRevision();
+    const scenePre = store.currentSceneRevision(viewerRef);
+    journal.semantic = {
+      awirPre,
+      awirPost: awirPre + 1,
+      scenePre,
+      scenePost: scenePre + 1,
+      deltaKind: "updated",
+      projectionId: existingProjection.id.canonical,
+      deltaId: sceneDeltaId(journal.core.reference, journal.core.eventId).canonical,
+    };
+    writeAtomicJson(path, journal);
+  }
+
+  if (!alreadyCurrent) {
+    advanceCounterTo(store, "awir", viewerRef, journal.semantic.awirPre, journal.semantic.awirPost);
+    const projection = buildStatusProjection(
+      journal,
+      existingProjection,
+      reconciliationRecord,
+      journal.semantic.awirPost,
+    );
+    assert(c4.validateWorldProjection(projection), "external adoption status projection invalid");
+    const nextProjections = [
+      ...store.list("worldProjections").filter(
+        (item) => item.id.canonical !== projection.id.canonical,
+      ),
+      projection,
+    ];
+    assert(
+      c4.validateWorldProjectionStore({ ...store.snapshot(), worldProjections: nextProjections }),
+      "external adoption status projection store invalid",
+    );
+    store.commitCollection("worldProjections", nextProjections);
+
+    advanceCounterTo(store, "scene", viewerRef, journal.semantic.scenePre, journal.semantic.scenePost);
+    const delta = {
+      id: sceneDeltaId(journal.core.reference, journal.core.eventId),
+      viewerRef,
+      baseRevision: journal.semantic.scenePre,
+      nextRevision: journal.semantic.scenePost,
+      created: [],
+      updated: [projection.id.canonical],
+      removed: [],
+      emittedAt: journal.core.observedAt,
+    };
+    const existingDelta = store.list("sceneDeltas").find(
+      (item) => item.id.canonical === delta.id.canonical,
+    );
+    if (existingDelta === undefined) {
+      assert(c4.validateSceneDelta(delta), "external adoption status SceneDelta invalid");
+      const nextDeltas = [...store.list("sceneDeltas"), delta];
+      assert(
+        c4.validateSceneDeltaStore({ ...store.snapshot(), sceneDeltas: nextDeltas }),
+        "external adoption status SceneDelta store invalid",
+      );
+      store.commitCollection("sceneDeltas", nextDeltas);
+    } else {
+      assert(canonicalEqual(existingDelta, delta), "status SceneDelta replay diverged");
+    }
+  }
+
+  journal.transport.phase = "observed";
+  writeAtomicJson(path, journal);
+  return {
+    eventId: journal.core.eventId,
+    reference: journal.core.reference,
+    status: journal.core.status,
+    projectionId: journal.semantic.projectionId,
+    ackReady: false,
+  };
+}
+
+function assertJournalRevisionIdentity(journals) {
+  const acceptedByRevision = new Map();
+  for (const { journal } of journals) {
+    if (journal.kind !== "accepted_lineage") continue;
+    assert(
+      Array.isArray(journal.core?.lineage)
+        && Array.isArray(journal.readbacks)
+        && journal.core.lineage.length === journal.readbacks.length,
+      "accepted journal lineage is incomplete",
+    );
+    for (let index = 0; index < journal.core.lineage.length; index += 1) {
+      const item = journal.core.lineage[index];
+      const key = `${journal.core.reference}\0${item.revision}`;
+      const evidence = {
+        eventId: item.eventId,
+        readback: journal.readbacks[index],
+      };
+      const existing = acceptedByRevision.get(key);
+      if (existing !== undefined && !canonicalEqual(existing, evidence)) {
+        throw new ExternalAdoptionDivergenceError([
+          sha256(canonicalJson(existing)),
+          sha256(canonicalJson(evidence)),
+        ]);
+      }
+      acceptedByRevision.set(key, evidence);
+    }
+  }
+}
+
+export function reconcileExternalAdoptionJournal(
+  store,
+  journalDirectory,
+  { viewerRef = EXTERNAL_ADOPTION_VIEWER } = {},
+) {
+  assert(
+    viewerRef === EXTERNAL_ADOPTION_VIEWER,
+    "viewerRef is outside the durable R5C source-viewer authorization mapping",
+  );
+  const journals = safeJournalFiles(journalDirectory)
+    .map((name) => ({ path: join(journalDirectory, name), journal: readJournal(join(journalDirectory, name)) }))
+    .sort((left, right) => (
+      left.journal.journalSequence - right.journal.journalSequence
+      || left.journal.core.eventId.localeCompare(right.journal.core.eventId)
+    ));
+  assertJournalRevisionIdentity(journals);
+  return journals.map(({ journal, path }) => {
+    if (journal.kind === "accepted_lineage") {
+      return reconcileAcceptedJournal(store, journal, path, viewerRef);
+    }
+    if (journal.kind === "status_observation") {
+      return reconcileStatusJournal(store, journal, path, viewerRef);
+    }
+    throw new Error("unsupported journal observation");
+  });
+}
+
+function externalUrl(baseUrl, path) {
+  return new URL(path, baseUrl).toString();
+}
+
+async function postJson(fetchImpl, url, { body, bearer }) {
+  const response = await fetchImpl(url, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      ...(bearer === undefined ? {} : { authorization: `Bearer ${bearer}` }),
+    },
+    body: JSON.stringify(body),
+  });
+  return response;
+}
+
+function externalAdoptionReferences(store) {
+  return store.list("worldProjections")
+    .filter((projection) => projection.archetypeRef === "ARCHETYPE::external-consumer-adoption-claim")
+    .map((projection) => store.list("entities").find(
+      (entity) => entity.id.canonical === projection.binding.semanticEntityIds[0],
+    )?.identity.externalRefs.find(
+      (ref) => ref.sourceSystem === SOURCE_SYSTEM,
+    )?.externalId)
+    .filter((reference) => REFERENCE_PATTERN.test(reference));
+}
+
+function observeSourceStatus(store, journalDirectory, viewerRef, observedAt, status) {
+  const references = [...new Set(externalAdoptionReferences(store))];
+  for (const reference of references) {
+    stageExternalAdoptionStatusObservation(journalDirectory, {
+      reference,
+      status,
+      observedAt,
+    });
+  }
+  if (references.length > 0) {
+    reconcileExternalAdoptionJournal(store, journalDirectory, { viewerRef });
+  }
+  return references.length;
+}
+
+function observeDeliveryStatusIfKnown(
+  store,
+  journalDirectory,
+  viewerRef,
+  delivery,
+  observedAt,
+  status,
+  evidenceDigests = [],
+) {
+  if (!externalAdoptionReferences(store).includes(delivery.reference)) {
+    return false;
+  }
+  stageExternalAdoptionStatusObservation(journalDirectory, {
+    reference: delivery.reference,
+    status,
+    observedAt,
+    evidenceDigests,
+  });
+  reconcileExternalAdoptionJournal(store, journalDirectory, { viewerRef });
+  return true;
+}
+
+export async function runExternalAdoptionPollCycle({
+  store,
+  journalDirectory,
+  baseUrl,
+  worldClaimCapability,
+  worldId,
+  leaseMs = 10_000,
+  fetchImpl = fetch,
+  viewerRef = EXTERNAL_ADOPTION_VIEWER,
+  now = () => new Date().toISOString(),
+}) {
+  assert(
+    viewerRef === EXTERNAL_ADOPTION_VIEWER,
+    "viewerRef is outside the durable R5C source-viewer authorization mapping",
+  );
+  reconcileExternalAdoptionJournal(store, journalDirectory, { viewerRef });
+  let claimResponse;
+  try {
+    claimResponse = await postJson(
+      fetchImpl,
+      externalUrl(baseUrl, "/api/external/adoption-outbox/claim"),
+      {
+        bearer: worldClaimCapability,
+        body: { worldId, leaseMs },
+      },
+    );
+  } catch {
+    return {
+      outcome: "source_unavailable",
+      status: null,
+      processed: [],
+      observations: observeSourceStatus(
+        store,
+        journalDirectory,
+        viewerRef,
+        now(),
+        "offline",
+      ),
+    };
+  }
+  if (!claimResponse.ok) {
+    return {
+      outcome: "source_unavailable",
+      status: claimResponse.status,
+      processed: [],
+      observations: observeSourceStatus(
+        store,
+        journalDirectory,
+        viewerRef,
+        now(),
+        "offline",
+      ),
+    };
+  }
+  let claimBody;
+  try {
+    claimBody = await claimResponse.json();
+    assert(Array.isArray(claimBody.deliveries), "claim response deliveries missing");
+  } catch {
+    return {
+      outcome: "invalid_source_response",
+      status: claimResponse.status,
+      processed: [],
+      observations: observeSourceStatus(
+        store,
+        journalDirectory,
+        viewerRef,
+        now(),
+        "stale",
+      ),
+    };
+  }
+  const processed = [];
+
+  for (const delivery of claimBody.deliveries) {
+    try {
+      validateDelivery(delivery);
+      assert(
+        delivery.readerHandle.viewerId === EXTERNAL_ADOPTION_SOURCE_VIEWER,
+        "delivery source viewer is not authorized for the R5C projection",
+      );
+      assert(
+        viewerRef === EXTERNAL_ADOPTION_VIEWER,
+        "target viewer is outside the R5C source-viewer authorization mapping",
+      );
+    } catch {
+      observeSourceStatus(store, journalDirectory, viewerRef, now(), "stale");
+      continue;
+    }
+    const readbacks = [];
+    let readable = true;
+    let malformed = false;
+    for (const lineageItem of delivery.lineage) {
+      let readResponse;
+      try {
+        readResponse = await postJson(
+          fetchImpl,
+          externalUrl(baseUrl, "/api/external/adoption-readback"),
+          {
+            body: {
+              ...delivery.readerHandle,
+              revision: lineageItem.revision,
+            },
+          },
+        );
+      } catch {
+        readable = false;
+        break;
+      }
+      if (!readResponse.ok) {
+        readable = false;
+        break;
+      }
+      try {
+        readbacks.push(await readResponse.json());
+      } catch {
+        malformed = true;
+        break;
+      }
+    }
+    if (!readable || malformed) {
+      observeDeliveryStatusIfKnown(
+        store,
+        journalDirectory,
+        viewerRef,
+        delivery,
+        now(),
+        malformed ? "stale" : "offline",
+      );
+      continue;
+    }
+
+    try {
+      stageExternalAdoptionBatch(journalDirectory, delivery, readbacks);
+    } catch (error) {
+      const disputed = error instanceof ExternalAdoptionDivergenceError;
+      const evidenceDigests = disputed ? error.evidenceDigests : [];
+      observeDeliveryStatusIfKnown(
+        store,
+        journalDirectory,
+        viewerRef,
+        delivery,
+        now(),
+        disputed ? "disputed" : "stale",
+        evidenceDigests,
+      );
+      continue;
+    }
+    const reconciled = reconcileExternalAdoptionJournal(store, journalDirectory, { viewerRef })
+      .find((item) => item.eventId === delivery.eventId);
+    assert(reconciled?.ackReady === true, "semantic postcondition not ack-ready");
+    const ackResponse = await postJson(
+      fetchImpl,
+      externalUrl(baseUrl, "/api/external/adoption-outbox/ack"),
+      {
+        bearer: worldClaimCapability,
+        body: {
+          worldId,
+          reference: delivery.reference,
+          eventId: delivery.eventId,
+          leaseToken: delivery.leaseToken,
+        },
+      },
+    );
+    if (!ackResponse.ok) continue;
+    let ackBody;
+    try {
+      ackBody = await ackResponse.json();
+    } catch {
+      continue;
+    }
+    if (ackBody?.acknowledged !== true) continue;
+    const path = journalPath(journalDirectory, delivery.eventId);
+    const journal = readJournal(path);
+    journal.transport = { phase: "ack_confirmed", ackConfirmed: true };
+    writeAtomicJson(path, journal);
+    processed.push(reconciled);
+  }
+  return { outcome: "processed", processed };
+}
