+import {
+  EXTERNAL_ADOPTION_VIEWER,
+  reconcileExternalAdoptionJournal,
+  runExternalAdoptionPollCycle,
+} from "@agent-world/semantic-kernel/external-adoption";
+import { createMemoryStore } from "@agent-world/semantic-kernel/store";
+
+function requiredEnvironment(name) {
+  const value = process.env[name];
+  if (typeof value !== "string" || value.length === 0) {
+    throw new Error(`missing required environment variable: ${name}`);
+  }
+  return value;
+}
+
+const journalDirectory = requiredEnvironment("AGENT_WORLD_ADOPTION_JOURNAL_PATH");
+const baseUrl = requiredEnvironment("ALLBUDDY_BASE_URL");
+const worldClaimCapability = requiredEnvironment("ALLBUDDY_WORLD_CLAIM_CAPABILITY");
+const worldId = process.env.AGENT_WORLD_ID ?? "agent-world:r5c-local";
+const store = createMemoryStore();
+
+reconcileExternalAdoptionJournal(store, journalDirectory, {
+  viewerRef: EXTERNAL_ADOPTION_VIEWER,
+});
+const poll = await runExternalAdoptionPollCycle({
+  store,
+  journalDirectory,
+  baseUrl,
+  worldClaimCapability,
+  worldId,
+  viewerRef: EXTERNAL_ADOPTION_VIEWER,
+});
+
+const projections = store.list("worldProjections").map((projection) => ({
+  id: projection.id.canonical,
+  awirRevision: projection.awirRevision,
+  humanNarrative: projection.humanNarrative,
+  states: Object.fromEntries(
+    projection.stateModifiers.map((modifier) => [modifier.channel, modifier.value]),
+  ),
+  eventRecordIds: projection.binding.eventRecordIds,
+  sourceRefs: projection.binding.sourceRefs.map((source) => ({
+    sourceSystem: source.sourceSystem,
+    externalRecordId: source.externalRecordId,
+    executionProvenance: source.executionProvenance,
+  })),
+}));
+
+process.stdout.write(`${JSON.stringify({
+  outcome: poll.outcome,
+  processed: poll.processed.length,
+  projections,
+  counts: {
+    adapterSnapshots: store.list("adapterSnapshots").length,
+    eventRecords: store.list("eventRecords").length,
+    entities: store.list("entities").length,
+    worldProjections: projections.length,
+    sceneDeltas: store.list("sceneDeltas").length,
+  },
+}, null, 2)}\n`);
