digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.28, ranksep=0.42, fontname="Noto Sans CJK SC"];
  node [shape=box, style="rounded", fontname="Noto Sans CJK SC", fontsize=13, margin="0.12,0.08", color="#444444"];
  edge [color="#666666", penwidth=1.3, arrowsize=0.7];
  l0 [label="L0 主权世界\nPrincipal · 私有上下文 · 工具 · 资源 · 本地 Harness"];
  l1 [label="L1 边界与发现\nNC / NAC · 多语义签名 · Discovery Provider · BIC / Local Oracle"];
  l2 [label="L2 问题构成与共同介质\nCoordination Schema · SJAC · JAA · Shared Artifact"];
  l3 [label="L3 可能性形成\nPFE · 类型化 Unknown · VOI / EVPF · 工具/伙伴/授权/任务重构"];
  l4 [label="L4 能力兑现与资格化\nCRA · Experiment · Witness · Holdout · Drift · Capability Contract"];
  l5 [label="L5 主体认领与制度化\nRecognition · AuthorityGrant · Commitment · ResourceReservation"];
  l6 [label="L6 执行与现实效力\nHarness · ActionAttempt · Effect · Adoption · Verification · Acceptance"];
  l7 [label="L7 演化与编译世界\nEvent Ledger · Compiled World · Defeater · Schema/Skill 演化"];
  l0 -> l1 -> l2 -> l3 -> l4 -> l5 -> l6 -> l7;
  l7 -> l0 [label="反馈、学习与世界更新", fontname="Noto Sans CJK SC", fontsize=11, style=dashed];
}
