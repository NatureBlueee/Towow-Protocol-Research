+def _reference_source_id(value: object) -> str | None:
+    """Extract the canonical source owner from typed or endpoint-shaped reference data."""
+    if not isinstance(value, dict):
+        return None
+    direct = value.get("source_concept_id")
+    if isinstance(direct, str) and direct:
+        return direct
+    for key in ("source_entity", "source"):
+        endpoint = value.get(key)
+        if not isinstance(endpoint, dict):
+            continue
+        entity_id = endpoint.get("id", endpoint.get("entity_id"))
+        if isinstance(entity_id, str) and entity_id:
+            return entity_id
+    return None
+
+
+def _reference_instance_matches(
+    reference: dict[str, object],
+    source_id: str | None,
+    reference_id: object,
+) -> bool:
+    """Match one source-scoped instance; ``None`` is a legacy identity, never a wildcard."""
+    if reference.get("reference_id") != reference_id:
+        return False
+    return _reference_source_id(reference) == source_id
+
+
+def _upsert_reference(
+    references: list[dict[str, object]],
+    source_id: str | None,
+    reference_id: str,
+    value: dict[str, object],
+) -> None:
+    """Replay-safe upsert keyed by (source owner, locator), not locator alone."""
+    for existing in references:
+        if _reference_instance_matches(existing, source_id, reference_id) and (
+            source_id is not None or _reference_source_id(existing) is None
+        ):
+            existing.update(value)
+            return
+    references.append(value)
+
