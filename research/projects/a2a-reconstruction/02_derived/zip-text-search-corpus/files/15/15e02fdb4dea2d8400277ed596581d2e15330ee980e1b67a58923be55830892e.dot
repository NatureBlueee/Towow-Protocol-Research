digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, fontname="Noto Sans CJK SC", newrank=true];
 node [shape=box, style="rounded", fontname="Noto Sans CJK SC", fontsize=12, width=1.75, height=0.65];
 edge [fontname="Noto Sans CJK SC", fontsize=10];
 n0 [label="0 身份与\n权威根"];
