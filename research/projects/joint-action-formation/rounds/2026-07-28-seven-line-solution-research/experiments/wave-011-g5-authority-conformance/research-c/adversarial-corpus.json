      "attack_family": "REGISTRY",
      "stratum": "SC-P",
      "public_input": {
        "operation_ref": "op-reg-01",
        "required_owner": "owner-external",
        "cached_head": 18
      },
      "timeline": [
        {
          "seq": 1,
          "boundary": "READ",
          "actor": "registry",
          "event": "serve signed head=18 SUPPORT to verifier-A",
          "visibility": "native_response_A"
        },
        {
          "seq": 2,
          "boundary": "READ",
          "actor": "registry",
          "event": "serve signed head=19 REVOKED to verifier-B",
          "visibility": "native_response_B"
        }
      ],
      "oracle": {
        "expected_decision": "UNKNOWN",
        "required_observations": [
          "both signatures are valid",
          "owner head fork detected",
          "no globally established current head"
        ],
        "forbidden_success_claims": [
          "latest numeric head is authoritative without fork resolution",
          "signed SUPPORT permits execution",
          "registry is a free current-truth oracle"
        ]
      }
    },
