{
  "schema_version": "wave011-g5-adversarial-corpus-v1",
  "kind": "ADVERSARIAL_CORPUS_DRAFT",
  "status": "DRAFT_NOT_RUN",
  "evidence_boundary": {
    "level": "LOCAL_SYNTHETIC_TEST_DESIGN",
    "is_product_comparison": false,
    "is_real_authority_evidence": false,
    "can_support_if_run": [
      "a listed false-closure trace is reproducible in the tested implementation",
      "a tested arm preserves native outcomes and owner boundaries on this corpus",
      "a tested migration has witnessed equivalence only for the executed source-target cases"
    ],
    "cannot_support": [
      "general real-world G5 closure",
      "legal sufficiency",
      "product-wide OPA Cedar OpenFGA or XACML comparison",
      "simultaneous cross-Authority atomicity",
      "semantic equivalence outside the executed migration corpus",
      "a canonical IR or new protocol requirement"
    ]
  },
  "method_visibility": {
    "method_may_read": [
      "case.public_input",
      "case.timeline event payloads exposed by lawful interfaces",
      "native provider response bytes returned by those interfaces"
    ],
    "method_must_not_read": [
      "case.oracle",
      "case.attack_family",
      "private owner state",
      "truth labels",
      "future timeline events",
      "other arm outputs"
    ],
    "evaluator_may_read_after_return_seal": [
      "case.oracle",
      "sealed method return",
      "sealed native provider transcript",
      "owner ledgers",
      "target readback"
    ]
  },
  "decision_vocabulary": {
    "business_decisions": [
      "ALLOW",
      "REJECT",
      "UNKNOWN",
      "DEFER",
      "INVALID",
      "COMPENSATE_RECONCILE"
    ],
    "rule": "A business decision is derived by a versioned task mapping from preserved native outcome, error, version, freshness, and authoritative negative facts. The corpus never supplies a precomputed business decision to a method."
  },
  "strong_center_strata": [
    {
      "id": "SC-U",
      "name": "TRUE_UNIFIED_AUTHORITY",
      "definition": "One Principal legally and operationally owns, or may validly receive delegation of, every required Authority; no relevant external non-delegable right, standing, separation-of-duties constraint, or external acceptance remains.",
      "center_may_close": [
        "policy",
        "mandate",
        "stance",
        "reservation",
        "commitment",
        "execution fence"
      ],
      "external_effect_rule": "Every material side effect is enforced by the same consistency domain or by an explicitly tested target fence.",
      "fair_win": "A strong center wins if it meets all safety and liveness gates and has lower measured lifecycle cost. This is a positive result."
    },
    {
      "id": "SC-P",
      "name": "SAME_TECHNICAL_PERMISSION_EXTERNAL_RIGHT",
      "definition": "The center has byte-identical accounts, APIs, database privileges, keys available to its own services, and observations as SC-U, but one required right belongs to an external owner and is non-delegable.",
      "center_may_close": [
        "its own records",
        "coordination",
        "queries to the external owner"
      ],
      "center_must_not_close": [
        "the external owner's stance",
        "the external owner's commitment",
        "the external owner's acceptance"
      ],
      "fair_win": "A strong center may still win by obtaining or waiting for owner-native evidence. Writing approved=true with administrator permission is false closure."
    },
    {
      "id": "SC-E",
      "name": "SINGLE_DOMAIN_TRANSACTION_EXTERNAL_EFFECT",
      "definition": "Policy, mandate, reservation, commitment record, and outbox are atomically committed in one database, while the material effect occurs at an external device, portal, institution, or human process.",
      "center_may_close": [
        "the local transaction",
        "intent and outbox durability"
      ],
      "center_must_not_claim": [
        "atomic external Effect",
        "exactly-once external Effect without target enforcement and readback",
        "Acceptance from a local transaction"
      ],
      "fair_win": "A strong center wins only if idempotency, target-side monotonic fencing, readback, reconciliation, and compensation meet the same gates as other arms."
    }
  ],
  "fairness_contract": {
    "arms": [
      "STRONG_CENTER",
      "MATURE_COMPOSITION",
      "CLM_HITL",
      "HUMAN_RULES",
      "CANDIDATE_ADAPTER"
    ],
    "equalized_inputs": [
      "authoritative source APIs",
      "technical permissions",
      "network and clock distribution",
      "policy and business rules",
      "human reviewer pool",
      "disclosure budget",
      "retry and recovery budget",
      "target enforcement interfaces"
    ],
    "critical_gates": [
      "no controller substitution",
      "no authoritative Reject or forbid promoted to Allow",
      "no UNKNOWN or unmapped native error promoted to Allow",
      "no stale or wrong material operation closure",
      "no duplicate or stale target Effect",
      "legal positive cases eventually progress within the liveness bound",
      "native negative facts and provenance survive tested migration"
    ],
    "winner_rule": "First require every critical gate. Among correct arms compare p50/p95/p99 latency, human minutes, disclosure, availability product, abort and retry count, compensation, maintenance, restore, and migration cost.",
    "positive_results": [
      "STRONG_CENTER wins SC-U",
      "MATURE_COMPOSITION closes SC-P with zero candidate increment",
      "CLM_HITL or HUMAN_RULES wins a low-frequency high-consequence slice",
      "a candidate residual disappears after adding an owner API, configuration fix, transaction constraint, or target fence",
      "native outcomes plus a thin task adapter outperform a universal four-value wrapper"
    ],
    "invalid_comparisons": [
      "granting the center fictional ownership of an external right",
      "granting the candidate a hidden truth API",
      "charging one arm for owner reads while giving another a free current registry",
      "counting UNKNOWN as correct REJECT",
      "counting a local ledger token as target enforcement",
      "calling a simulated shape an actual product integration"
    ]
  },
