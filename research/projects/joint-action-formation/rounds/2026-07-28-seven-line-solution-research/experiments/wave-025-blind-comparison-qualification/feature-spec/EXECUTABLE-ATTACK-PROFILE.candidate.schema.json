{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towow:wave025:executable-attack-profile-candidate:v1",
  "title": "Wave025 executable attack profile candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "version",
    "status",
    "authority",
    "derivation",
    "scope",
    "formal_population",
    "receipt_contract",
    "feature_families",
    "leaf_audit",
    "raw_direct_scan",
    "learned_matrix",
    "attacks",
    "statistics",
    "positive_controls",
    "host_only_audit",
    "abnormal_fail_closed",
    "cost_and_replay_ceiling",
    "output_prohibitions",
    "not_tested",
    "adoption_gate"
  ],
  "properties": {
    "schema": {
      "const": "WAVE025_EXECUTABLE_ATTACK_PROFILE_CANDIDATE_V1"
    },
    "profile_id": {
      "const": "EAP-025-FIRST-RUN-V1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "CANDIDATE_NOT_SHARED_TRUTH_NOT_EXECUTED"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "may_change_shared_contract",
        "may_produce_qualification_verdict",
        "may_rank_treatments",
        "requires_new_precommit_hash",
        "requires_user_or_shared_contract_adoption"
      ],
      "properties": {
        "classification": {
          "const": "CANDIDATE_NOT_SHARED_TRUTH"
        },
        "may_change_shared_contract": {
          "const": false
        },
        "may_produce_qualification_verdict": {
          "const": false
        },
        "may_rank_treatments": {
          "const": false
        },
        "requires_new_precommit_hash": {
          "const": true
        },
        "requires_user_or_shared_contract_adoption": {
          "const": true
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_feature_spec_path",
        "full_feature_spec_sha256",
        "redteam_path",
        "redteam_sha256",
        "independent_evaluator_profile_role",
        "power_revision"
      ],
      "properties": {
        "full_feature_spec_path": {
          "type": "string"
        },
        "full_feature_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redteam_path": {
          "type": "string"
        },
        "redteam_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "independent_evaluator_profile_role": {
          "const": "SMOKE_AND_ADDITIONAL_COMPRESSED_ATTACK_VIEW_ONLY"
        },
        "power_revision": {
          "const": "FORMAL_TOTAL_3200_T_CALIBRATION_400_T_HOLDOUT_2400_D0_200_D1_200"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_cut",
        "collector_receipt_schema",
        "formal_suite_shape",
        "actual_comparative_runs",
        "result_state",
        "treatment_ranking"
      ],
      "properties": {
        "observation_cut": {
          "const": "T0_SEALED_TO_T1_PUBLIC_PREIMAGE"
        },
        "collector_receipt_schema": {
          "const": "WAVE025_LEAK_ONLY_FEATURES_V1"
        },
        "formal_suite_shape": {
          "const": "ONE_BATCH_D0_D1_T_ONE_PRECOMMIT_CLOSE_REVEAL"
        },
        "actual_comparative_runs": {
          "const": 0
        },
        "result_state": {
          "const": "NO_RESULT"
        },
        "treatment_ranking": {
          "const": "PROHIBITED"
        }
      }
    },
    "formal_population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D0-HOST-LEAK",
        "D1-OCI-CANARY",
        "T-OCI-ISOLATED",
        "total_slots",
        "total_blocks",
        "balance_rule",
        "post_return_extension"
      ],
      "properties": {
        "D0-HOST-LEAK": {
          "$ref": "#/$defs/populationStratum"
        },
        "D1-OCI-CANARY": {
          "$ref": "#/$defs/populationStratum"
        },
        "T-OCI-ISOLATED": {
          "$ref": "#/$defs/populationStratum"
        },
        "total_slots": {
          "type": "integer",
          "minimum": 1
        },
        "total_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "balance_rule": {
          "const": "EXACT_R_S_BALANCE_WITHIN_CHALLENGE_PHASE_BLOCK"
        },
        "post_return_extension": {
          "const": "FORBIDDEN"
        }
      }
    },
    "receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_schema",
        "accepted_top_level_fields_exact",
        "unknown_field_policy",
        "missing_field_policy",
        "label_join_order",
        "forbidden_predictor_sources"
      ],
      "properties": {
        "accepted_schema": {
          "const": "WAVE025_LEAK_ONLY_FEATURES_V1"
        },
        "accepted_top_level_fields_exact": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "unknown_field_policy": {
          "const": "PROFILE_ABNORMAL_FAIL_CLOSED"
        },
        "missing_field_policy": {
          "const": "PROFILE_ABNORMAL_FAIL_CLOSED"
        },
        "label_join_order": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "forbidden_predictor_sources": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "feature_families": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/featureFamily"
      }
    },
    "leaf_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_rule",
        "included_rule",
        "excluded_fields_exact",
        "required_audit_outputs",
        "unclassified_paths_required_value",
        "audit_members_are_predictors"
      ],
      "properties": {
        "partition_rule": {
          "const": "EVERY_SCALAR_LEAF_EXACTLY_ONE_OF_INCLUDED_OR_EXCLUDED"
        },
        "included_rule": {
          "const": "ALL_VALIDATED_CANDIDATE_VISIBLE_NONCONSTANT_LEAVES"
        },
        "excluded_fields_exact": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/excludedField"
          }
        },
        "required_audit_outputs": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "unclassified_paths_required_value": {
          "type": "array",
          "maxItems": 0
        },
        "audit_members_are_predictors": {
          "const": false
        }
      }
    },
    "raw_direct_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "categorical_rules",
        "numeric_rules",
        "minimum_total_calibration_support",
        "minimum_per_predicted_class_support",
        "selection_phase",
        "holdout_reselection",
        "registered_control_path_policy",
        "learned_matrix_quota_applies"
      ],
      "properties": {
        "input": {
          "const": "ALL_INCLUDED_RAW_LEAVES_BEFORE_LEARNED_COMPRESSION"
        },
        "categorical_rules": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "numeric_rules": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "minimum_total_calibration_support": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_per_predicted_class_support": {
          "type": "integer",
          "minimum": 1
        },
        "selection_phase": {
          "const": "CALIBRATION_ONLY"
        },
        "holdout_reselection": {
          "const": "FORBIDDEN"
        },
        "registered_control_path_policy": {
          "const": "MANDATORY_PIN_BEFORE_ANCHOR"
        },
        "learned_matrix_quota_applies": {
          "const": false
        }
      }
    },
    "learned_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_count",
        "numeric",
        "categorical",
        "lexical",
        "family_norms",
        "maximum_total_width",
        "preprocessing"
      ],
      "properties": {
        "family_count": {
          "const": 7
        },
        "numeric": {
          "$ref": "#/$defs/numericMatrix"
        },
        "categorical": {
          "$ref": "#/$defs/categoricalMatrix"
        },
        "lexical": {
          "$ref": "#/$defs/lexicalMatrix"
        },
        "family_norms": {
          "$ref": "#/$defs/familyNorms"
        },
        "maximum_total_width": {
          "type": "integer",
          "minimum": 1
        },
        "preprocessing": {
          "$ref": "#/$defs/preprocessing"
        }
      }
    },
    "attacks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/directAttack"
        },
        {
          "$ref": "#/$defs/logisticAttack"
        },
        {
          "$ref": "#/$defs/stumpAttack"
        },
        {
          "$ref": "#/$defs/treeAttack"
        },
        {
          "$ref": "#/$defs/knn5Attack"
        },
        {
          "$ref": "#/$defs/knn11Attack"
        }
      ],
      "items": false
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "confidence_intervals",
        "thresholds",
        "permutation",
        "holm"
      ],
      "properties": {
        "metric": {
          "const": "BALANCED_ACCURACY_HALF_RECALL_R_PLUS_HALF_RECALL_S"
        },
        "confidence_intervals": {
          "$ref": "#/$defs/confidenceIntervals"
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "permutation": {
          "$ref": "#/$defs/permutation"
        },
        "holm": {
          "$ref": "#/$defs/holm"
        }
      }
    },
    "positive_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_D0_and_D1",
        "registry_freeze",
        "required_registration_fields",
        "allowed_primary_detector_ids",
        "D0-HOST-LEAK",
        "D1-OCI-CANARY"
      ],
      "properties": {
        "pool_D0_and_D1": {
          "const": false
        },
        "registry_freeze": {
          "const": "BEFORE_EXTERNAL_ANCHOR"
        },
        "required_registration_fields": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "allowed_primary_detector_ids": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "D0-HOST-LEAK": {
          "$ref": "#/$defs/positiveControl"
        },
        "D1-OCI-CANARY": {
          "$ref": "#/$defs/positiveControl"
        }
      }
    },
    "host_only_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excluded_from_predictor_exact",
        "association_audit_required",
        "numeric_statistic",
        "categorical_statistic",
        "set_path_statistic",
        "permutation_family",
        "may_copy_association_fields_into_learned_matrix"
      ],
      "properties": {
        "excluded_from_predictor_exact": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "association_audit_required": {
          "const": true
        },
        "numeric_statistic": {
          "type": "string"
        },
        "categorical_statistic": {
          "type": "string"
        },
        "set_path_statistic": {
          "type": "string"
        },
        "permutation_family": {
          "const": "T_HOST_ONLY_ASSOCIATIONS"
        },
        "may_copy_association_fields_into_learned_matrix": {
          "const": false
        }
      }
    },
    "abnormal_fail_closed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_outcome",
        "conditions",
        "may_translate_abnormal_to_chance",
        "may_reduce_profile_after_formal_data",
        "refreeze_required_before_retry"
      ],
      "properties": {
        "default_outcome": {
          "const": "PROFILE_ABNORMAL_NO_CHANCE_SCORE_NO_QUALIFICATION_RESULT"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/abnormalCondition"
          }
        },
        "may_translate_abnormal_to_chance": {
          "const": false
        },
        "may_reduce_profile_after_formal_data": {
          "const": false
        },
        "refreeze_required_before_retry": {
          "const": true
        }
      }
    },
    "cost_and_replay_ceiling": {
      "$ref": "#/$defs/costCeiling"
    },
    "output_prohibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_verdict",
        "A1_A5_score_coverage_pareto_ranking_winner",
        "shared_contract_promotion",
        "unknown_leak_absence_claim"
      ],
      "properties": {
        "qualification_verdict": {
          "const": "PROHIBITED_BY_THIS_CANDIDATE_ARTIFACT"
        },
        "A1_A5_score_coverage_pareto_ranking_winner": {
          "const": "PROHIBITED"
        },
        "shared_contract_promotion": {
          "const": "REQUIRES_SEPARATE_USER_OR_CONTRACT_DECISION"
        },
        "unknown_leak_absence_claim": {
          "const": "PROHIBITED"
        }
      }
    },
    "not_tested": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adoption_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "required_before_formal_use",
        "automatic_promotion",
        "formal_use_before_adoption"
      ],
      "properties": {
        "current_state": {
          "const": "CANDIDATE_ONLY"
        },
        "required_before_formal_use": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "automatic_promotion": {
          "const": false
        },
        "formal_use_before_adoption": {
          "const": "FORBIDDEN"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "populationStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration",
        "holdout",
        "calibration_per_role",
        "holdout_per_role",
        "block_size",
        "calibration_blocks",
        "holdout_blocks"
      ],
      "properties": {
        "calibration": {
          "type": "integer",
          "minimum": 1
        },
        "holdout": {
          "type": "integer",
          "minimum": 1
        },
        "calibration_per_role": {
          "type": "integer",
          "minimum": 1
        },
        "holdout_per_role": {
          "type": "integer",
          "minimum": 1
        },
        "block_size": {
          "type": "integer",
          "minimum": 2
        },
        "calibration_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "holdout_blocks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "featureFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_visible_roots",
        "learned_numeric_quota",
        "direct_scan_required",
        "mandatory_feature_groups"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F0[1-7]_[A-Z0-9_]+$"
        },
        "candidate_visible_roots": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "learned_numeric_quota": {
          "const": 32
        },
        "direct_scan_required": {
          "const": true
        },
        "mandatory_feature_groups": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "excludedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_pattern",
        "reason_code"
      ],
      "properties": {
        "path_pattern": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "numericMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths_per_family",
        "maximum_selected_paths",
        "missing_bit_per_path",
        "maximum_width_including_missing",
        "unused_family_quota_transfer",
        "selection_phase",
        "selection_inputs",
        "label_aware_selection",
        "quota_overflow"
      ],
      "properties": {
        "paths_per_family": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_selected_paths": {
          "type": "integer",
          "minimum": 1
        },
        "missing_bit_per_path": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_width_including_missing": {
          "type": "integer",
          "minimum": 1
        },
        "unused_family_quota_transfer": {
          "const": "FORBIDDEN"
        },
        "selection_phase": {
          "const": "CALIBRATION_ONLY"
        },
        "selection_inputs": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "label_aware_selection": {
          "const": false
        },
        "quota_overflow": {
          "const": "PROFILE_ABNORMAL_REFREEZE_BEFORE_FORMAL"
        }
      }
    },
    "categoricalMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banks_per_family",
        "dimensions_per_bank",
        "total_width",
        "encoding",
        "bank_domains",
        "count_transform",
        "hash_collision_audit"
      ],
      "properties": {
        "banks_per_family": {
          "type": "integer",
          "minimum": 1
        },
        "dimensions_per_bank": {
          "type": "integer",
          "minimum": 1
        },
        "total_width": {
          "type": "integer",
          "minimum": 1
        },
        "encoding": {
          "const": "SIGNED_SHA256_FEATURE_HASH_COUNT"
        },
        "bank_domains": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "count_transform": {
          "type": "string"
        },
        "hash_collision_audit": {
          "const": true
        }
      }
    },
    "lexicalMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ngram_n",
        "dimensions_per_family",
        "total_width",
        "hash_domain",
        "maximum_bytes_scanned_per_string",
        "overlength_rule",
        "full_value_sha256_stays_in_direct_scan"
      ],
      "properties": {
        "ngram_n": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dimensions_per_family": {
          "type": "integer",
          "minimum": 1
        },
        "total_width": {
          "type": "integer",
          "minimum": 1
        },
        "hash_domain": {
          "type": "string"
        },
        "maximum_bytes_scanned_per_string": {
          "type": "integer",
          "minimum": 1
        },
        "overlength_rule": {
          "type": "string"
        },
        "full_value_sha256_stays_in_direct_scan": {
          "const": true
        }
      }
    },
    "familyNorms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_per_family",
        "total_width",
        "value"
      ],
      "properties": {
        "one_per_family": {
          "const": true
        },
        "total_width": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "const": "LOG1P_PRENORMALIZATION_L2_NORM"
        }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_phase",
        "logistic_and_knn",
        "stump_and_tree",
        "numeric_scale",
        "missing_fill",
        "feature_order",
        "class_order"
      ],
      "properties": {
        "fit_phase": {
          "type": "string"
        },
        "logistic_and_knn": {
          "type": "string"
        },
        "stump_and_tree": {
          "type": "string"
        },
        "numeric_scale": {
          "type": "string"
        },
        "missing_fill": {
          "type": "string"
        },
        "feature_order": {
          "type": "string"
        },
        "class_order": {
          "type": "string"
        }
      }
    },
    "directAttack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "fit_phase",
        "inference_phase",
        "minimum_total_support",
        "minimum_per_predicted_class_support",
        "stable_recovery",
        "tie_break"
      ],
      "properties": {
        "id": {
          "const": "A-DIRECT"
        },
        "kind": {
          "const": "RAW_DETERMINISTIC_DIRECT_SCAN"
        },
        "fit_phase": {
          "const": "CALIBRATION_ONLY"
        },
        "inference_phase": {
          "const": "FRESH_HOLDOUT_ONLY"
        },
        "minimum_total_support": {
          "type": "integer"
        },
        "minimum_per_predicted_class_support": {
          "type": "integer"
        },
        "stable_recovery": {
          "type": "string"
        },
        "tie_break": {
          "type": "string"
        }
      }
    },
    "logisticAttack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "fit_phase",
        "inference_phase",
        "l2",
        "maximum_iterations",
        "gradient_linf_stop",
        "initial_step",
        "backtracking_factor",
        "armijo_c",
        "probability_threshold",
        "nonconvergence",
        "tie_prediction"
      ],
      "properties": {
        "id": {
          "const": "A-LOGISTIC"
        },
        "kind": {
          "const": "L2_LOGISTIC_FULL_BATCH_ARMIJO"
        },
        "fit_phase": {
          "const": "CALIBRATION_ONLY"
