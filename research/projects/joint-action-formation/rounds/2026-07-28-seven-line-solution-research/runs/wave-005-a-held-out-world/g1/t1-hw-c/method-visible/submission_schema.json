{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "towow-t1-hidden-world-c-submission-2.0",
  "title": "T1-HW-C method-visible submission",
  "description": "Candidate-owned observable signatures and externally returned execution evidence only.",
  "type": "object",
  "required": [
    "schema_version",
    "world_id",
    "evaluation_step",
    "method_id",
    "decisions",
    "projection_updates",
    "execution_proofs",
    "relation_handoffs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "world_id": {"type": "string", "minLength": 1},
    "evaluation_step": {"type": "integer", "minimum": 0},
    "method_id": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "projection_updates": {
      "type": "array",
      "items": {"$ref": "#/$defs/projectionUpdate"}
    },
    "execution_proofs": {
      "type": "array",
      "items": {"$ref": "#/$defs/executionProof"}
    },
    "relation_handoffs": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationHandoff"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "DISCOVERED",
        "INVALIDATED",
        "UNFINDABLE_UNDER_POLICY",
        "UNKNOWN",
        "REFUSE",
        "ABSENT"
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "detection_id",
            "kind",
            "state",
            "seeker",
            "provider",
            "direction",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "detection_id": {"type": "string", "minLength": 1},
            "kind": {"const": "PAIR"},
            "state": {"$ref": "#/$defs/state"},
            "seeker": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "direction": {"const": "SEEK_TO_OFFER"},
            "evidence_refs": {"$ref": "#/$defs/stringList"}
          }
        },
        {
          "type": "object",
          "required": [
            "detection_id",
            "kind",
            "state",
            "claim_key",
            "subject",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "detection_id": {"type": "string", "minLength": 1},
            "kind": {"const": "CLAIM"},
            "state": {"$ref": "#/$defs/state"},
            "claim_key": {"type": "string", "minLength": 1},
            "subject": {"type": "string", "minLength": 1},
            "evidence_refs": {"$ref": "#/$defs/stringList"}
          }
        }
      ]
    },
    "projectionUpdate": {
      "type": "object",
      "required": [
        "party",
        "invalidated_signature",
        "from_version",
        "to_version",
        "step",
        "current_direction",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "party": {"type": "string", "minLength": 1},
        "invalidated_signature": {"type": "string", "minLength": 1},
        "from_version": {"type": "integer", "minimum": 0},
        "to_version": {"type": "integer", "minimum": 0},
        "step": {"type": "integer", "minimum": 0},
        "current_direction": {"enum": ["SEEK", "OFFER"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "executionProof": {
      "type": "object",
      "required": [
        "action_id",
        "detection_id",
        "action_kind",
        "status",
        "action_digest",
        "idempotency_key",
        "delivery_events",
        "controller_receipt_ref",
        "recipient_ack_refs",
        "external_anchor_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "detection_id": {"type": "string", "minLength": 1},
        "action_kind": {
          "enum": ["DERIVED_ONWARD", "RECIPROCAL_EXCHANGE"]
        },
        "status": {
          "enum": [
            "EXECUTED_VERIFIED",
            "EXECUTION_REJECTED",
            "EXECUTION_NOT_REQUESTED"
          ]
        },
        "action_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "delivery_events": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/deliveryEvent"}
        },
        "controller_receipt_ref": {"type": "string", "minLength": 1},
        "recipient_ack_refs": {"$ref": "#/$defs/stringList"},
        "external_anchor_ref": {"type": "string", "minLength": 1}
      }
    },
    "deliveryEvent": {
      "type": "object",
      "required": [
        "event_ref",
        "origin_party",
        "sender",
        "recipient",
        "fact_id",
        "depth",
        "purpose",
        "retention"
      ],
      "additionalProperties": false,
      "properties": {
        "event_ref": {"type": "string", "minLength": 1},
        "origin_party": {"type": "string", "minLength": 1},
        "sender": {"type": "string", "minLength": 1},
        "recipient": {"type": "string", "minLength": 1},
        "fact_id": {"type": "string", "minLength": 1},
        "depth": {"type": "integer", "minimum": 0},
        "purpose": {"type": "string", "minLength": 1},
        "retention": {"type": "string", "minLength": 1}
      }
    },
    "relationHandoff": {
      "type": "object",
      "required": [
        "detection_id",
        "status",
        "commitment",
        "authority_inferred",
        "evidence_refs",
        "open_questions"
      ],
      "additionalProperties": false,
      "properties": {
        "detection_id": {"type": "string", "minLength": 1},
        "status": {"const": "CANDIDATE_NOT_COMMITMENT"},
        "commitment": {"const": false},
        "authority_inferred": {"const": false},
        "evidence_refs": {"$ref": "#/$defs/stringList"},
        "open_questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
