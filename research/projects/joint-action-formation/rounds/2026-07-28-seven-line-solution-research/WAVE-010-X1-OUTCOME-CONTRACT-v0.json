  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "raw_bytes_sha256",
        "owner_key_id",
        "receipt_version",
        "status"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "raw_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_key_id": {
          "type": "string",
          "minLength": 1
        },
        "receipt_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "hash_binding_rules": {
    "schema_sha256": {
      "algorithm": "SHA-256",
      "preimage": "canonical JSON bytes of the exact object {\"$defs\": <RFC6901 /$defs>, \"category_registry\": <RFC6901 /category_registry>, \"outcome_schema\": <RFC6901 /outcome_schema>}",
      "current_preimage_sha256": "be1a818eef4f7438ed238559ed6594aa422b056af36f26ee7ff90f53aff3d4fe",
      "instance_field": "schema_sha256",
      "mismatch_result": "UNRESOLVED_SCHEMA/SCHEMA_HASH_MISMATCH"
    },
    "reason_registry_sha256": {
      "algorithm": "SHA-256",
      "preimage": "canonical JSON bytes of the exact object {\"reason_registry\": <RFC6901 /reason_registry>, \"reason_registry_version\": <RFC6901 /reason_registry_version>}",
      "current_preimage_sha256": "6ab1de71f251c87414d00bc14693a970ddfa35474956a78928d9b65928b0d8dc",
      "instance_field": "reason_registry_sha256",
      "mismatch_result": "UNRESOLVED_SCHEMA/REASON_REGISTRY_HASH_MISMATCH"
    }
  },
  "validation_rules": [
    "category MUST be registered in category_registry",
    "reason_code MUST be registered under the exact category in reason_registry",
    "unregistered category, reason_code, or category/reason pair MUST fail closed as UNRESOLVED_SCHEMA and MUST NOT be normalized to UNKNOWN or INVALID",
    "the unresolved wrapper MUST preserve the attempted raw bytes SHA-256 and the schema or registry failure reason",
    "all four line receipt refs and all four transition receipt refs are mandatory; a non-reached line or transition MUST supply an owner-signed typed NOT_REACHED receipt rather than null",
    "every receipt MUST resolve to the same x1_run_id, x1_world_id, x1_arm_id, episode anchor, and finalized output",
    "reason_code MUST preserve the exact blocking reason proven by the raw receipt; generic G5_DENY or G5_BLOCKED normalization is forbidden when the receipt proves REQUIRE_APPROVAL, STALE_VERSION, RESERVATION_REQUIRED, RESERVATION_CONFLICT, REVOKED, or EXPIRED",
    "AUTHORITY_VALID_FRONT_HALF_CANDIDATE is valid only with ALL_LINE_OUTPUTS_ACCEPTED_AND_TRANSITIONS_CURRENT and current owner-issued receipts",
    "G5 success requires current owner receipts for mandate, stance, commitment, and heads from all four authority domains plus the delta resource-owner reservation receipt; one aggregate or single-domain commitment cannot satisfy the gate",
    "G5 non-success MUST emit exactly one registered category/reason pair proven by the blocking receipt; composite reason buckets are forbidden and an unregistered pair fails closed as UNRESOLVED_SCHEMA/UNREGISTERED_CATEGORY_REASON_PAIR",
    "schema and reason-registry hashes are recomputed from this exact contract version at every X1 finalize and X2 ingress",
    "this outcome is an X1 front-half handoff only and MUST NOT imply execution permission, Effect, Adoption, Acceptance, Settlement, or Q_episode satisfaction"
  ]
}
