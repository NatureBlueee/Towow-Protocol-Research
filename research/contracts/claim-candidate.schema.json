{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://towow.local/research/contracts/claim-candidate.schema.json",
  "title": "ClaimCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "claim",
    "scope",
    "supporting_evidence",
    "counterevidence",
    "independence",
    "failure_conditions",
    "promotion_requirements",
    "origin"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "ClaimCandidate"},
    "id": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
    "version": {"type": "string"},
    "status": {
      "enum": ["CANDIDATE", "SUPPORTED_LOCAL", "REJECTED", "INCONCLUSIVE", "STABLE"]
    },
    "claim": {"type": "string", "minLength": 20},
    "scope": {"type": "string", "minLength": 8},
    "supporting_evidence": {"type": "array", "items": {"type": "string"}},
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_sources", "shared_generator_warning"],
      "properties": {
        "independent_sources": {"type": "integer", "minimum": 0},
        "shared_generator_warning": {"type": "boolean"}
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "promotion_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "run_ids"],
      "properties": {
        "batch_id": {"type": "string"},
        "run_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
