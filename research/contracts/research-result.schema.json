{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://towow.local/research/contracts/research-result.schema.json",
  "title": "ResearchResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "batch_id",
    "line_id",
    "status",
    "question_version",
    "scenario_version",
    "input_hash",
    "direct_observations",
    "source_statements",
    "inferences",
    "design_proposals",
    "negative_results",
    "alternative_explanations",
    "evidence_refs",
    "applicability",
    "cannot_support",
    "candidate_claims",
    "new_discriminators",
    "cost"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "2.0"]},
    "kind": {"type": "string", "const": "ResearchResult"},
    "run_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "line_id": {"type": "string"},
    "status": {"enum": ["COMPLETED", "INCONCLUSIVE", "REFUSED", "FAILED"]},
    "question_version": {"type": "string"},
    "scenario_version": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "direct_observations": {"type": "array", "items": {"type": "string"}},
    "source_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "source_locator", "source_range"],
        "properties": {
          "statement": {"type": "string"},
          "source_locator": {"type": "string"},
          "source_range": {"type": "string"}
        }
      }
    },
    "inferences": {"type": "array", "items": {"type": "string"}},
    "design_proposals": {"type": "array", "items": {"type": "string"}},
    "negative_results": {"type": "array", "items": {"type": "string"}},
    "alternative_explanations": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "applicability": {"type": "string", "minLength": 8},
    "cannot_support": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "candidate_claims": {"type": "array", "items": {"type": "string"}},
    "new_discriminators": {"type": "array", "items": {"type": "string"}},
    "hypothesis_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "tested_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "hypothesis_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "outcome",
          "rationale",
          "evidence_refs"
        ],
        "properties": {
          "hypothesis_id": {"type": "string"},
          "outcome": {
            "enum": [
              "COMPLETED",
              "INCONCLUSIVE",
              "INVALIDATED",
              "NOT_RUN"
            ]
          },
          "rationale": {"type": "string", "minLength": 12},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "scoped_claim_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "proposed_status",
          "rationale",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {"type": "string"},
          "proposed_status": {
            "enum": [
              "UNCHANGED",
              "SUPPORTED_CANDIDATE",
              "NARROWED",
              "REFUTED_CANDIDATE",
              "REBASE_REQUIRED_CANDIDATE",
              "REOPEN_REQUEST",
              "UNKNOWN"
            ]
          },
          "rationale": {"type": "string", "minLength": 12},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "unaffected_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_seconds", "output_bytes"],
      "properties": {
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "2.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "hypothesis_ids",
          "hypothesis_outcomes",
          "tested_claim_ids",
          "scoped_claim_updates",
          "unaffected_claim_ids"
        ]
      }
    }
  ]
}
